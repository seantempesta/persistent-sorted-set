;; bin/forks loads a unit file alone, with no fork test directory on a path: the test storage it requires is loaded first.
(load-file "reference-code/persistent-sorted-set/test/org/replikativ/persistent_sorted_set/test/storage.jolt")

(ns org.replikativ.persistent-sorted-set.test.jolt-count-fixes
  "The Jolt port's tests for upstream 0.5.145's count-mode fixes whose upstream test lives in a
  namespace the port cannot load (it needs diff-buf, impl.nodes, from-sorted-seq, compact or
  markFreed of children). Each deftest names the upstream test or CHANGES.md entry it is
  taken from; the scenarios and the numbers are upstream's."
  (:require [clojure.test :refer [deftest testing is]]
            [org.replikativ.persistent-sorted-set :as pset]
            [org.replikativ.persistent-sorted-set.test.storage :as ts])
  (:import [org.replikativ.persistent_sorted_set PersistentSortedSet]))

(def cmp-full
  (fn [[k1 v1] [k2 v2]]
    (let [c (compare k1 k2)]
      (if (zero? c) (compare v1 v2) c))))

(def cmp-k
  (fn [[k1 _] [k2 _]] (compare k1 k2)))

;; ---- store() never wrote a child that was mutated in place (CHANGES.md 0.5.x) -------------
;; Upstream's scenario is freed_tracking.clj's run-checkpointed-transient (10,000 [k 0] at bf
;; 32, stored; one transient stored MID-EDIT each of 20 rounds and mutated further). Upstream
;; asserts the freed-address accounting there, which the port does not keep for children; this
;; asserts what the CHANGES entry measured ("in-mem 220 reloaded 219 missing [21]"): the set
;; restored cold from the last store's address is the one in memory.

(defn- run-checkpointed-transient [mutate!]
  (let [disk (atom {})
        settings (pset/default-settings 32)
        storage (ts/->Storage (atom {}) disk settings)
        s0 (reduce (fn [s k] (pset/conj s [k 0] cmp-full))
                   (pset/sorted-set* {:comparator cmp-full :storage storage :branching-factor 32})
                   (range 10000))
        _ (pset/store s0 storage)
        t (transient s0)
        _ (dotimes [round 20]
            (mutate! t round)
            (pset/store t storage))
        root-addr (pset/store t storage)
        s-final (persistent! t)
        reloaded (pset/restore-by cmp-full root-addr (ts/->Storage (atom {}) disk settings)
                                  {:branching-factor 32})]
    {:in-memory (vec s-final) :reloaded (vec reloaded)}))

(deftest a-checkpointed-transient-stores-what-it-changed-in-place
  (testing "conj: [k 1] lands between [k 0] and [k+1 0], an interior insert into a leaf with
            room, which returns EARLY_EXIT"
    (let [{:keys [in-memory reloaded]}
          (run-checkpointed-transient
           (fn [t round] (dotimes [i 32] (pset/conj t [(+ (* round 32) i) 1] cmp-full))))
          model (vec (concat (mapcat (fn [k] [[k 0] [k 1]]) (range 640))
                             (for [k (range 640 10000)] [k 0])))]
      (is (= model in-memory))
      (is (= model reloaded) "the reloaded set holds every element conj'd after a store")))
  (testing "disj"
    (let [{:keys [in-memory reloaded]}
          (run-checkpointed-transient
           (fn [t round] (dotimes [i 32] (pset/disj t [(+ (* round 32) i) 0] cmp-full))))
          model (vec (for [k (range 640 10000)] [k 0]))]
      (is (= model in-memory))
      (is (= model reloaded) "the reloaded set holds no element disj'd after a store")))
  (testing "replace"
    (let [{:keys [in-memory reloaded]}
          (run-checkpointed-transient
           (fn [t round]
             (dotimes [i 32]
               (let [k (+ (* round 32) i)]
                 (pset/replace t [k 0] [k (inc round)] cmp-k)))))
          model (vec (for [k (range 10000)] (if (< k 640) [k (inc (quot k 32))] [k 0])))]
      (is (= model in-memory))
      (is (= model reloaded) "the reloaded set holds every replacement made after a store"))))

;; ---- disj/replace and lookup disagreed on which comparator-equal element they act on --------
;; CHANGES.md 0.5.x: lookup takes the LEFTMOST element equal under the operation comparator, the
;; mutating operations whatever Arrays.binarySearch returned. Upstream fixed it with
;; ANode.searchFirstEq (its D1) and tests it through its cljs parity and generative suites,
;; which the port cannot load; this states the CHANGES entry's claim for the `[id value]`
;; compared-by-id pattern: disj under cmp-k removes the element lookup reports.

(deftest disj-removes-the-element-lookup-reports
  (doseq [bf [4 8 32] transient? [false true]]
    (let [s (reduce #(pset/conj %1 %2 cmp-full)
                    (pset/sorted-set* {:comparator cmp-full :branching-factor bf})
                    (for [k (range 40) j (range 3)] [k j]))]
      (doseq [k (range 40)]
        (let [probe [k 99]
              seen (pset/lookup s probe cmp-k)
              after (if transient?
                      (persistent! (pset/disj (transient s) probe cmp-k))
                      (pset/disj s probe cmp-k))]
          (is (= [k 0] seen) (str "bf=" bf ": lookup takes the leftmost"))
          (is (not (contains? after seen))
              (str "bf=" bf " transient=" transient? ": disj removed " seen ", the element lookup reported"))
          (is (= (dec (count s)) (count after))))))))

;; ---- the bulk builders honour :meta ---------------------------------------------------------
;; CHANGES.md 0.5.x "`from-sorted-seq` honours `:meta` on the JVM": it built with a hard-coded
;; {} while sorted-set* passed (:meta opts) through; from-sorted-array's 0- and 1-node arms did
;; the same in 0.4.137 (the port: nil). Upstream's test is in bulk_build.clj, on from-sorted-seq,
;; which the port does not have; this states it for from-sorted-array and from-sequential.

(deftest the-bulk-builders-keep-meta
  (doseq [n [0 5 2000]]
    (is (= {:x 1} (meta (pset/from-sorted-array compare (to-array (range n)) n {:meta {:x 1}})))
        (str "from-sorted-array, " n " elements"))
    (is (= {:x 1} (meta (pset/from-sequential compare (range n) {:meta {:x 1}})))
        (str "from-sequential, " n " elements"))
    (is (nil? (meta (pset/from-sorted-array compare (to-array (range n)) n {})))
        (str "no :meta is nil, as sorted-set*, " n " elements"))))

;; ---- nil cannot get in through any entry point ----------------------------------------------
;; CHANGES.md 0.5.x "Two entry points allowed nil into a set": replace's new key and
;; from-sorted-array (a nil element, or a len past the array). These three deftests are
;; upstream's, from cljs_api_parity.cljc (a namespace the port cannot load whole: it tests
;; compact), with arr-of as (to-array xs); test/.../contract.jolt and empty_bulk_build.jolt
;; hold the other entry points.

(deftest replace-refuses-a-nil-new-key
  (let [s (pset/from-sorted-array compare (to-array [1 2 3]) 3)]
    (is (thrown? IllegalArgumentException (pset/replace s 2 nil))
        "a nil replacement must be refused")
    (is (= [1 2 3] (vec s)) "and the set is untouched")))

(deftest an-out-of-range-len-is-refused
  (doseq [[label arr len] [["empty array, len 1" [] 1]
                           ["len past the end"   [1 2 3] 5]
                           ["negative len"       [1 2 3] -1]]]
    (is (thrown? clojure.lang.ExceptionInfo
                 (pset/from-sorted-array compare (to-array arr) len))
        (str label ": must be refused, not silently accepted"))))

(deftest a-nil-element-is-refused-by-from-sorted-array
  (is (thrown? IllegalArgumentException
               (pset/from-sorted-array compare (to-array [1 nil 3]) 3))
      "a nil element anywhere")
  (is (thrown? IllegalArgumentException
               (pset/from-sorted-array compare (to-array [nil 1]) 2))
      "including a LEADING nil, which under `compare` is legitimately ascending"))
