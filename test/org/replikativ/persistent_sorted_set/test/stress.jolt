;; bin/forks loads a unit file alone, with no fork test directory on a path: the test storage it requires is loaded first.
(load-file "reference-code/persistent-sorted-set/test/org/replikativ/persistent_sorted_set/test/storage.jolt")

(ns org.replikativ.persistent-sorted-set.test.stress
  (:require
   [org.replikativ.persistent-sorted-set :as set]
   #?(:clj [org.replikativ.persistent-sorted-set.test.storage :as storage])
   [clojure.test :as t :refer [is are deftest testing]]))

;; Jolt port: on Jolt `(seq s)` of the port's set is a clojure.lang.Cons, not the set's own Seq
;; (Jolt's `seq` does not reach the set's Seqable.seq), so it has no `seek`; the ascending seqs
;; here are `(set/slice s nil nil)`, which is what `seq` answers on the JVM.

;; Jolt port: the iteration counts are cut to keep the unit near 30 s on Jolt (upstream's ran
;; 5 min 15 s here): iters 100 -> 10, stresstest-rslice 10000 -> 100 rounds, test-overflow
;; 4,000,000 -> 400,000 elements. Each round is the same random property as upstream's.
(def iters 10)

(defn into-via-doseq [to from]
  (let [res (transient [])]
    (doseq [x from]  ;; checking chunked iter
      (conj! res x))
    (persistent! res)))

(deftest stresstest-btset
  (println "  testing stresstest-btset...")
  (loop [i 0]
    (when (< i iters)
      (when
       (let [size 10000
             xs        (vec (repeatedly (+ 1 (rand-int size)) #(rand-int size)))
             xs-sorted (vec (distinct (sort xs)))
             rm        (vec (repeatedly (rand-int (* size 5)) #(rand-nth xs)))
             full-rm   (shuffle (concat xs rm))
             xs-rm     (reduce disj (into (sorted-set) xs) rm)
             ops [["conj" (into (set/sorted-set) xs)]
                  ["bulk" (apply set/sorted-set xs)]
                  #?(:clj ["lazy" (storage/roundtrip (into (set/sorted-set) xs))])]]
         (loop [ops ops]
           (if-let [[method set0] (first ops)]
             (let [set1 (reduce disj set0 rm)
                   set2 (persistent! (reduce disj (transient set0) rm))
                   set3 (reduce disj set0 full-rm)
                   set4 (persistent! (reduce disj (transient set0) full-rm))]
               (if
                (testing
                 (str "Iter:" (inc i)  "/" iters \newline
                      "set:" method \newline
                      "adds:" (str (count xs) " (" (count xs-sorted) " distinct),") \newline
                      "removals:" (str (count rm) " (down to " (count xs-rm) ")"))
                  (and
                   (testing "conj, seq"
                     (is (= (vec set0) xs-sorted)))
                   (testing "eq"
                     (is (= set0 (set xs-sorted)) xs-sorted))
                   (testing "count"
                     (is (= (count set0) (count xs-sorted))))
                   (testing "doseq"
                     (is (= (into-via-doseq [] set0) xs-sorted)))
                   (testing "disj"
                     (and
                      (if-not (is (= (vec set1) (vec xs-rm)))
                        (do
                          #?(:cljs (do
                                     (set! (.-set0 js/window) set0)
                                     (set! (.-rm js/window) rm)
                                     (set! (.-xs-rm js/window) xs-rm)))
                          false)
                        true)
                      (is (= (count set1) (count xs-rm)))
                      (is (= set1 xs-rm))))
                   (testing "disj transient"
                     (and
                      (is (= (vec set2) (vec xs-rm)))
                      (is (= (count set2) (count xs-rm)))
                      (is (= set2 xs-rm))))
                   (testing "full disj"
                     (and
                      (is (= set3 #{}))
                      (is (= set4 #{}))))))
                 (recur (rest ops))))
             true)))
        (recur (inc i))))))

(deftest stresstest-slice
  (println "  testing stresstest-slice...")
  (loop [i 0]
    (when (< i iters)
      (let [xs        (repeatedly (+ 1 (rand-int 20000)) #(rand-int 20000))
            xs-sorted (distinct (sort xs))
            [from to] (sort [(- 10000 (rand-int 20000)) (+ 10000 (rand-int 20000))])
            expected  (filter #(<= from % to) xs-sorted)
            ops [["conj" (into (set/sorted-set) xs)]
                 #?(:clj ["lazy" (storage/roundtrip (into (set/sorted-set) xs))])]]
        (when
         (loop [ops ops]
           (if-let [[method set] (first ops)]
             (let [set-range (set/slice set from to)]
               (when
                (testing
                 (str
                  "Iter: " (inc i) "/" iters
                  ", set:" method
                  ", from:" (count xs-sorted) " elements"
                  ", down to:" (count expected))
                  (and
                   (let [set (into (set/sorted-set) (shuffle xs-sorted))]
                     (is (= (set/rslice set 30000 -10)
                            (-> (set/rslice set 30000 -10) rseq reverse))))
                   (is (= (vec set-range) (vec (seq set-range)))) ;; checking IReduce on BTSetIter
                   (is (= (vec set-range) expected))
                   (is (= (into-via-doseq [] set-range) expected))
                   ;; An EMPTY range is a legitimate outcome — `slice` answers nil, the way
                   ;; `seq` does — and `rseq` cannot be called on it. This is reached about
                   ;; once every few hundred runs, when the random [from,to] misses every
                   ;; element (overwhelmingly when `xs` happens to hold a single distinct
                   ;; value), and it made the suite intermittently NPE with a stack trace
                   ;; that pointed at the library rather than at the test. Assert the nil
                   ;; instead of dereferencing it.
                   ;; Jolt port: two assertions on the nil arm, as on the other, so the unit's
                   ;; count (which bin/forks compares) does not depend on the random range
                   (if (nil? set-range)
                     (and (is (empty? expected)
                              "slice returned nil, so the expected range must be empty")
                          (is (nil? (seq expected))))
                     (and
                      (is (= (vec (rseq set-range)) (reverse expected)))
                      (is (= (vec (rseq (rseq set-range))) expected))))))
                 (recur (rest ops))))
             true))
          (recur (inc i)))))))

(deftest stresstest-rslice
  (println "  testing stresstest-rslice...")
  (loop [i 0]
    (when (< i 100)
      (let [len 3000
            xs  (vec (shuffle (range 0 (inc 3000))))
            s   (into (set/sorted-set) xs)]
        (when
         (testing (str "Iter: " i "/1000")
           (is (=
                (set/rslice s (+ 3000 100) -100)
                (-> (set/rslice s (+ 3000 100) -100) rseq reverse))))
          (recur (inc i)))))))

(deftest stresstest-seek
  (println "  testing stresstest-seek...")
  (loop [i 0]
    (when (< i iters)
      (let [xs        (repeatedly (inc (rand-int 20000)) #(rand-int 20000))
            xs-sorted (distinct (sort xs))
            seek-to   (rand-int 20000)
            set       (into (set/sorted-set) xs-sorted)]
        (when
         (testing (str "Iter: " i "/" iters ", seek to " seek-to)
           (and
            (is (= (seq (drop-while #(< % seek-to) xs-sorted))
                   (set/seek (set/slice set nil nil) seek-to)))

            (is (= (seq (drop-while #(< % 19999) xs-sorted))
                   (set/seek (set/slice set nil nil) 19999)))

            (is (= (seq (reverse (take-while #(<= % seek-to) xs-sorted)))
                   (set/seek (rseq set) seek-to)))

            (is (= (seq (reverse (take-while #(<= % 1) xs-sorted)))
                   (set/seek (rseq set) 1)))))
          (recur (inc i)))))))

(deftest test-overflow
  (println "  testing test-overflow...")
  (let [len  400000
        part (quot len 100)
        xss  (partition-all part (shuffle (range 0 len)))
        s    (reduce into (set/sorted-set) xss)]
    (is (= 10 (count (take 10 s))))))
