(ns ^{:doc "E4a: persistent-sorted-set's JVM core (org.replikativ.persistent_sorted_set.*, 0.5.145)
  translated to Clojure deftypes on Jolt. Jolt resolves this .jolt before the jar's .clj, and a
  deftype in this namespace gets the Java class name org.replikativ.persistent_sorted_set.<Name>,
  so Datahike's `:clj` imports, `instance?` checks, `extend-type` and interop calls reach it unchanged.

  Covered: count-boundary B+tree (Leaf/Branch), cons/disjoin/replace/lookup/lookupGE/contains,
  slice/rslice/seek (Seq), countSlice with subtree counts, transients (in-place edits of nodes made
  in the session, as the Java does), store/restore/walkAddresses through IStorage, ForwardCursor,
  from-sorted-array/from-sequential, diff-buffering (Slot / :diff-buf-size), and opt-in right-edge
  leaf append (:edge-append?).
  Not covered (Datahike's defaults leave them off): IMeasure, ILeafProcessor, MST boundary."}
 org.replikativ.persistent-sorted-set
  (:refer-clojure :exclude [conj disj sorted-set sorted-set-by replace])
  (:require [clojure.string]
            [org.replikativ.persistent-sorted-set.arrays :as arrays]))

;; ---------------------------------------------------------------------------
;; Interfaces (the Java interface names Datahike imports)

(definterface IStorage
  (restore [address])
  (accessed [address])
  (store [node])
  (markFreed [address])
  (isFreed [address])
  (freedInfo [address]))

(definterface ISubtreeCount (subtreeCount []))

;; A storage that keeps part of a key unread in its leaves (Datahike's large values, held as a
;; reference until read) implements IReadKey: the key as a reader receives it. Applied where a key
;; leaves the set (a seq's first and reduce, lookup), and never written back into its leaf: a leaf
;; weighs after a read what it weighed when a cache booked it, and a leaf a forked process inherited
;; is never written by a read (the storage keeps what it read, under its own weighed entry);
;; comparisons inside the set see the stored key.
(definterface IReadKey (readKey [key]))

(defn- read-key
  "keys[idx] of node as storage's reader receives it (IReadKey); the array is left as stored."
  [storage ^objects keys ^long idx]
  (let [k (aget keys idx)]
    (if (instance? IReadKey storage) (.readKey ^IReadKey storage k) k)))

(definterface ISeek (seek [to]) (seek [to cmp]))

(definterface INode
  (len [])
  (level [])
  (keys [])
  (maxKey [])
  (minKey [])
  (count [storage])
  (searchFirst [key cmp])
  (searchLast [key cmp])
  (walkAddresses [storage on-address])
  (store [storage]))

(definterface IBranch
  (address [i])
  (addresses [])
  (child [storage i])
  (slots [])
  (slotsForStorage []))

(definterface IPersistentSortedSet
  (cons [key cmp])
  (disjoin [key cmp])
  (replace [old-key new-key])
  (replace [old-key new-key cmp])
  (lookup [key])
  (lookup [key cmp])
  (lookupGE [key])
  (lookupGE [key cmp])
  (slice [from to])
  (slice [from to cmp])
  (rslice [from to])
  (rslice [from to cmp])
  (countSlice [from to])
  (countSlice [from to cmp])
  (hasSubtreeCounts [])
  (root [])
  (comparator [])
  (walkAddresses [on-address])
  (store [])
  (store [storage])
  (forwardCursor [])
  (forwardCursor [cmp]))

(definterface IForwardCursor (seekGE [key]) (next []) (current []))

;; Settings: branching factor, transient edit flag (a volatile holding true while the transient
;; session that created a node is open; nil for persistent nodes), diff-buf budget (0 = off,
;; byte-identical baseline), and ref/mode flags (:weak, :edge, :weak-edge, or nil). Keeping 4
;; fields preserves exact ABI compatibility with callers calling `(Settings. bf edit dbs refType)`.
(deftype Settings [_branchingFactor _edit ^long _diffBufSize _refType])

(defn- settings-weak? [^Settings s]
  (let [r (.-_refType s)] (or (= r :weak) (= r :weak-edge))))

(defn- settings-edge-append? [^Settings s]
  (let [r (.-_refType s)] (or (= r :edge) (= r :weak-edge))))

(defn- settings-editable? [^Settings s]
  (let [e (.-_edit s)] (and (some? e) @e)))

(defn- ensure-live-transient
  "Refuses a stale transient handle, one persistent! has sealed (upstream 0.5.145's
  ensureLiveTransient, Clojure's ensureEditable): its settings hold an edit flag that is false.
  A set never made transient holds none."
  [^Settings s]
  (let [e (.-_edit s)]
    (when (and (some? e) (not @e))
      (throw (IllegalAccessError. "Transient used after persistent! call")))))

(def ^:private ^:const min-branching-factor 4)

(defn- check-branching-factor
  "bf, or 512 when unset (nil, zero or negative). 1, 2 and 3 are refused (upstream 0.5.145's
  Settings.checkBranchingFactor): their minimum fill (bf >>> 1) is 1, so a branch of one child
  counts as full, that child has no sibling to rebalance with, a removal leaves an empty leaf,
  and a bulk build at bf 1 or 2 never reduces its level count."
  ^long [bf]
  (cond (or (nil? bf) (not (pos? bf))) 512
        (< bf min-branching-factor)
        (throw (IllegalArgumentException.
                (str "branching-factor " bf " is not supported: the minimum is " min-branching-factor
                     ". Pass 0 (or omit it) for the default of 512.")))
        :else bf))

(defn- make-settings
  ([] (make-settings 512 nil 0 false))
  ([bf] (make-settings bf nil 0 false))
  ([bf ref-type] (make-settings bf ref-type 0 false))
  ([bf ref-type diff-buf-size] (make-settings bf ref-type diff-buf-size false))
  ([bf ref-type diff-buf-size edge-append?]
   (let [dbs (long (or diff-buf-size 0))
         weak? (boolean (#{:weak :soft :weak-edge} ref-type))
         edge? (boolean (or edge-append? (#{:edge :weak-edge} ref-type)))
         rt (cond (and weak? edge?) :weak-edge
                  weak? :weak
                  edge? :edge
                  :else nil)]
     (when (neg? dbs)
       (throw (IllegalArgumentException. (str "diff-buf-size must be >= 0, got " dbs))))
     (Settings. (int (check-branching-factor bf)) nil dbs rt))))

(def ^:private ^:const expand-len 8)

(defn- new-len
  "The capacity of a node array of len entries: exact for a persistent node; in a transient,
  room to grow in place, len more (at least expand-len) up to the branching factor. Upstream
  grows by expand-len (8) alone; doubling copies a growing leaf O(log bf) times instead of
  O(bf/8) (Seon's EAVT at bf 64: 1,246 -> 845 B an insert)."
  ^long [^long len ^Settings s]
  (if (settings-editable? s)
    (min (.-_branchingFactor s) (+ len (max expand-len len)))
    len))

(def EARLY_EXIT (object-array 0))
(def UNCHANGED (object-array 0))

;; diff-buf sentinels & Slot (matches upstream 0.5.145 Slot.java / branch.cljs)
(def ^:const ABSENT :org.replikativ.persistent-sorted-set/absent)
(def ^:private ^:const BUF_WRITE -1)
(def ^:private ^:const BUF_LAZY -2)

;; Per-child buffered diff:
;;   diff       - live leaf-diff (sorted-map-by _projCmp: element -> element|ABSENT),
;;                wire leaf-diff {:absent [...] :present [...]},
;;                nil (live branch anchor marker — nested diff assembled at store), or
;;                nested branch-diff {child-idx -> {:count :measure :diff :max-key}}
;;   count      - exact subtree element count snapshot (ĝ.count)
;;   measure    - aggregate measure snapshot (nil on Jolt)
;;   anchor     - child's durable address (nil if child created/split this txn -> must write)
;;   bufEntries - buffered element count in child's subtree (-1 = BUF_WRITE, -2 = BUF_LAZY)
(deftype Slot [diff ^long count measure anchor ^long bufEntries])

;; ---------------------------------------------------------------------------
;; Array helpers

(defn- acopy [src ^long from ^long to dst ^long dst-from]
  (when (< from to)
    (System/arraycopy src from dst dst-from (- to from)))
  dst)

(defn- stitch
  "Copies src[from,to) into dst at pos; returns the new pos."
  ^long [src ^long from ^long to dst ^long pos]
  (if (and src (< from to))
    (do (System/arraycopy src from dst pos (- to from)) (+ pos (- to from)))
    (+ pos (max 0 (- to from)))))

(defn- search
  "Arrays.binarySearch over keys[0, len): index, or -(insertion point)-1."
  ^long [keys ^long len key cmp]
  (loop [lo 0 hi (dec len)]
    (if (<= lo hi)
      (let [mid (unsigned-bit-shift-right (+ lo hi) 1)
            d (long (cmp (aget keys mid) key))]
        (cond (neg? d) (recur (inc mid) hi)
              (pos? d) (recur lo (dec mid))
              :else mid))
      (- (inc lo)))))

(defn- search-first ^long [keys ^long len key cmp]
  (loop [lo 0 hi len]
    (if (< lo hi)
      (let [mid (unsigned-bit-shift-right (+ lo hi) 1)]
        (if (neg? (long (cmp (aget keys mid) key))) (recur (inc mid) hi) (recur lo mid)))
      lo)))

(defn- search-last ^long [keys ^long len key cmp]
  (loop [lo 0 hi len]
    (if (< lo hi)
      (let [mid (unsigned-bit-shift-right (+ lo hi) 1)]
        (if (<= (long (cmp (aget keys mid) key)) 0) (recur (inc mid) hi) (recur lo mid)))
      (dec lo))))

;; search's contract (index, or -(insertion point)-1) but the LEFTMOST of several keys cmp calls
;; equal, as lookup takes (upstream ANode.searchFirstEq): binarySearch disclaims which equal key
;; it finds, so disj or replace under a coarse cmp could act on another element than lookup's.
(defn- search-first-eq ^long [keys ^long len key cmp]
  (let [i (search-first keys len key cmp)]
    (if (and (< i len) (zero? (long (cmp (aget keys i) key)))) i (- (inc i)))))

;; ---------------------------------------------------------------------------
;; Nodes

(declare branch? leaf? node-child node-count subtree-count
         branch-slots-for-storage branch-store)

(deftype Leaf [^:unsynchronized-mutable _len _keys _settings]
  INode
  (len [_] _len)
  (level [_] 0)
  (keys [_] (vec (java.util.Arrays/copyOfRange _keys 0 _len)))
  (maxKey [_] (aget _keys (dec _len)))
  (minKey [_] (aget _keys 0))
  (count [_ _] _len)
  (searchFirst [_ key cmp] (search-first _keys _len key cmp))
  (searchLast [_ key cmp] (search-last _keys _len key cmp))
  (walkAddresses [_ _ _] nil)
  (store [this storage] (.store ^IStorage storage this))
  ISubtreeCount
  (subtreeCount [_] _len)
  Object
  (toString [_] (str "#Leaf" (vec (java.util.Arrays/copyOfRange _keys 0 _len)))))

;; _addresses / _children / _slots: arrays (or nil) with capacity >= _len.
;; _subtreeCount: entries below, -1 when unknown.
;; _bufEntries: buffered diff entry count in subtree (0 = clean/empty, -1 = BUF_WRITE, -2 = BUF_LAZY).
;; _projCmp: the set's stable comparator used by project-leaf (never a per-op navigation cmp).
(deftype Branch [_level ^:unsynchronized-mutable _len _keys
                 ^:unsynchronized-mutable _addresses ^:unsynchronized-mutable _children
                 ^:unsynchronized-mutable _subtreeCount _settings
                 ^:unsynchronized-mutable _slots ^:unsynchronized-mutable _bufEntries
                 ^:unsynchronized-mutable _projCmp]
  INode
  (len [_] _len)
  (level [_] _level)
  (keys [_] (vec (java.util.Arrays/copyOfRange _keys 0 _len)))
  (maxKey [_] (aget _keys (dec _len)))
  (minKey [_] (aget _keys 0))
  (count [this storage]
    (when (neg? _subtreeCount)
      (set! _subtreeCount
            (loop [i 0 acc 0]
              (if (< i _len)
                (recur (inc i) (+ acc (long (node-count (node-child this storage i) storage))))
                acc))))
    _subtreeCount)
  (searchFirst [_ key cmp] (search-first _keys _len key cmp))
  (searchLast [_ key cmp] (search-last _keys _len key cmp))
  (walkAddresses [this storage on-address]
    (dotimes [i _len]
      (let [a (when _addresses (aget _addresses i))]
        (when (or (nil? a) (on-address a))
          (when (> _level 1)
            (.walkAddresses ^INode (node-child this storage i) storage on-address))))))
  (store [this storage] (branch-store this storage))
  IBranch
  (address [_ i] (when _addresses (aget _addresses i)))
  (addresses [_] (if _addresses
                   (vec (java.util.Arrays/copyOfRange _addresses 0 _len))
                   (vec (repeat _len nil))))
  (child [this storage i] (node-child this storage i))
  (slots [_] _slots)
  (slotsForStorage [this] (branch-slots-for-storage this))
  ISubtreeCount
  (subtreeCount [_] _subtreeCount)
  Object
  (toString [_] (str "#Branch{:level " _level " :len " _len "}")))

(defn- leaf? [x] (instance? Leaf x))
(defn- branch? [x] (instance? Branch x))

(defn- node-len ^long [n] (if (leaf? n) (.-_len ^Leaf n) (.-_len ^Branch n)))
(defn- node-keys [n] (if (leaf? n) (.-_keys ^Leaf n) (.-_keys ^Branch n)))
(defn- node-settings [n] (if (leaf? n) (.-_settings ^Leaf n) (.-_settings ^Branch n)))
(defn- node-max-key [n] (aget (node-keys n) (dec (node-len n))))
(defn- node-editable? [n] (settings-editable? (node-settings n)))

;; ---------------------------------------------------------------------------
;; diff-buf helpers (upstream 0.5.145 Branch.java / branch.cljs parity)

(defn- settings-diff-buf? [^Settings s]
  (pos? (.-_diffBufSize s)))

(defn- diff-buf? [^Branch b]
  (pos? (.-_diffBufSize ^Settings (.-_settings b))))

(defn- slot-at [^Branch b ^long i]
  (when-let [^objects ss (.-_slots b)]
    (when (< i (alength ss))
      (aget ss i))))

(defn- leaf-diff->storage
  "Convert a live leaf-diff (sorted-map keyed by _projCmp) into comparator-agnostic
  {:absent [...] :present [...]}. Pass-through if already wire form or nil."
  [diff]
  (if-not (sorted? diff)
    diff
    (let [abs (transient [])
          pres (transient [])]
      (reduce-kv (fn [_ k v]
                   (if (= v ABSENT) (conj! abs k) (conj! pres v))
                   nil)
                 nil diff)
      {:absent (persistent! abs) :present (persistent! pres)})))

(defn- diff-size
  "Number of buffered leaf element-changes inside a slot diff at `child-level`."
  ^long [diff ^long child-level]
  (if-not (map? diff)
    0
    (if (== child-level 0)
      (if (sorted? diff)
        (long (count diff))
        (+ (long (count (:absent diff))) (long (count (:present diff)))))
      (if (zero? (count diff))
        0
        (reduce-kv (fn [^long acc _ v] (+ acc (diff-size (:diff v) (dec child-level))))
                   0 diff)))))

(defn- slot-be ^long [^Slot sl ^long child-level]
  (let [be (.-bufEntries sl)]
    (if (== be BUF_LAZY)
      (diff-size (.-diff sl) child-level)
      be)))

(defn- buf-entries
  "Buffered entry count of branch b's subtree (-1 = BUF_WRITE). Resolves BUF_LAZY once (IO-free)."
  ^long [^Branch b]
  (let [be (.-_bufEntries b)]
    (if (== be BUF_LAZY)
      (let [^objects ss (.-_slots b)
            clvl (dec (.-_level b))
            n (.-_len b)
            s (if (nil? ss)
                0
                (loop [j 0 acc 0]
                  (if (< j n)
                    (let [sl (aget ss j)]
                      (recur (inc j) (if sl (+ acc (slot-be sl clvl)) acc)))
                    acc)))]
        (set! (.-_bufEntries b) s)
        s)
      be)))

(defn- install-slots!
  "Install reconstructed slots on a not-yet-published Branch. Refuses non-nil slots when
  settings declare diff-buf-size <= 0 (matching upstream Branch.installSlots)."
  [^Branch b ^objects slots ^long entries]
  (when (and (some? slots) (not (diff-buf? b)))
    (let [n (loop [i 0 c 0]
              (if (< i (alength slots))
                (recur (inc i) (if (some? (aget slots i)) (inc c) c))
                c))]
      (when (pos? n)
        (throw (ex-info (str "diff-buf: a node reconstructed with diff-buf-size "
                             (.-_diffBufSize ^Settings (.-_settings b))
                             " was handed buffered slots. Storage must reconstruct it with :diff-buf-size > 0.")
                        {:diff-buf-size (.-_diffBufSize ^Settings (.-_settings b))
                         :slot-count n})))))
  (set! (.-_slots b) slots)
  (set! (.-_bufEntries b) entries)
  b)

(defn- project-leaf
  "Apply a leaf-diff (live sorted-map or wire {:absent :present}) to a durable Leaf in one pass
  under the set's stable comparator `proj-cmp`. Never mutates `base`."
  [^Leaf base diff proj-cmp]
  (let [^objects bkeys (.-_keys base)
        bn (.-_len base)
        m0 (loop [i 0 acc (sorted-map-by proj-cmp)]
             (if (< i bn)
               (let [k (aget bkeys i)] (recur (inc i) (assoc acc k k)))
               acc))
        m1 (if (sorted? diff)
             (reduce-kv (fn [acc k v]
                          (if (= v ABSENT) (dissoc acc k) (assoc acc v v)))
                        m0 diff)
             (let [m0 (reduce (fn [acc el] (dissoc acc el)) m0 (:absent diff))]
               (reduce (fn [acc el] (assoc acc el el)) m0 (:present diff))))
        n (count m1)
        arr (object-array n)
        pos (volatile! 0)]
    (reduce-kv (fn [_ _ v]
                 (let [i (long @pos)]
                   (aset arr i v)
                   (vreset! pos (inc i)))
                 nil)
               nil m1)
    (Leaf. n arr (.-_settings base))))

(defn- project-branch
  "Push one level of buffered diff down onto a COPY of `base` (never mutating a cached anchor
  shared across versions). Repairs child separators from :max-key and installs nested slots."
  [^Branch base ^Slot sl proj-cmp]
  (let [diff (.-diff sl)
        n (.-_len base)
        ^objects base-keys (.-_keys base)
        ^objects base-addr (.-_addresses base)
        new-keys (java.util.Arrays/copyOfRange base-keys 0 n)
        new-addr (when base-addr (java.util.Arrays/copyOfRange base-addr 0 n))
        slots (object-array n)]
    (reduce-kv (fn [_ k entry]
                 (let [i (int k)
                       mk (:max-key entry)]
                   (aset slots i (Slot. (:diff entry) (long (:count entry)) (:measure entry)
                                        (when base-addr (aget base-addr i)) BUF_LAZY))
                   (when (some? mk)
                     (aset new-keys i mk)))
                 nil)
               nil diff)
    (Branch. (.-_level base) n new-keys new-addr nil
             (.-count sl) (.-_settings base) slots BUF_LAZY proj-cmp)))

(defn- with-proj-cmp
  "A copy of `base` carrying `proj-cmp` instead of a conflicting cached `_projCmp`."
  [^Branch base proj-cmp]
  (let [n (.-_len base)
        ks (java.util.Arrays/copyOfRange (.-_keys base) 0 n)
        as (.-_addresses base)
        cs (.-_children base)
        na (when as (java.util.Arrays/copyOfRange as 0 n))
        nc (when cs
             (let [out (object-array n)]
               (dotimes [i n]
                 (when (and (or (nil? na) (nil? (aget na i))) (some? (aget cs i)))
                   (aset out i (aget cs i))))
               out))]
    (Branch. (.-_level base) n ks na nc (.-_subtreeCount base)
             (.-_settings base) (.-_slots base) (.-_bufEntries base) proj-cmp)))

(defn- stamp-proj-cmp
  "Seed `node`'s projection comparator, or copy if a cached branch already holds a different one."
  [node proj-cmp]
  (if-not (branch? node)
    node
    (let [^Branch b node
          cur (.-_projCmp b)]
      (cond
        (nil? cur) (do (set! (.-_projCmp b) proj-cmp) b)
        (identical? cur proj-cmp) b
        :else (with-proj-cmp b proj-cmp)))))

(defn- project-child
  "Project parent `b`'s buffered slot at `idx` onto freshly restored child `base`."
  [^Branch b ^long idx base]
  (let [^Slot sl (slot-at b idx)]
    (if (and sl (some? (.-diff sl)))
      (if (leaf? base)
        (project-leaf base (.-diff sl) (.-_projCmp b))
        (project-branch base sl (.-_projCmp b)))
      base)))

(defn- node-child
  "Branch child i, restored from storage by address when not in memory (stamping _projCmp and
  projecting any buffered slot). Under :weak settings the restored child is not kept in the
  branch (the storage's cache holds the pristine anchor), so a cached branch retains no subtree."
  [^Branch b storage ^long i]
  (let [cs (.-_children b)
        c (when cs (aget cs i))]
    (if (some? c)
      c
      (let [base0 (.restore ^IStorage storage (aget (.-_addresses b) i))
            base (if-let [pc (.-_projCmp b)] (stamp-proj-cmp base0 pc) base0)
            n (project-child b i base)]
        (when-not (settings-weak? (.-_settings b))
          (let [cs (or cs (let [a (object-array (alength (.-_keys b)))] (set! (.-_children b) a) a))]
            (aset cs i n)))
        n))))

(defn- set-child!
  "Installs node as branch b's child i in memory and clears its address (upstream's
  Branch.child(idx, node)): an address says the child's whole subtree is stored, which a child
  changed in place no longer is, so store must write it again."
  [^Branch b ^long i node]
  (when-let [as (.-_addresses b)] (aset as i nil))
  (let [cs (or (.-_children b) (let [a (object-array (alength (.-_keys b)))] (set! (.-_children b) a) a))]
    (aset cs i node)))

(defn- node-count ^long [n storage]
  (if (leaf? n) (.-_len ^Leaf n) (.count ^Branch n storage)))

(defn- subtree-count ^long [n]
  (if (leaf? n) (.-_len ^Leaf n) (.-_subtreeCount ^Branch n)))

(defn- children-count
  "Sum of in-memory children's subtree counts, -1 if any is unknown or not in memory."
  ^long [children ^long len]
  (if (nil? children)
    -1
    (loop [i 0 acc 0]
      (if (< i len)
        (let [c (aget children i)]
          (if (nil? c)
            -1
            (let [k (subtree-count c)] (if (neg? k) -1 (recur (inc i) (+ acc k))))))
        acc))))

(defn- new-leaf [^long len keys settings] (Leaf. len keys settings))

(defn- leaf-of-len [^long len settings]
  (Leaf. len (object-array (new-len len settings)) settings))

(defn- new-branch
  ([level ^long len keys addresses children ^long count settings]
   (Branch. level len keys addresses children count settings nil 0 nil))
  ([level ^long len keys addresses children ^long count settings proj-cmp]
   (Branch. level len keys addresses children count settings nil 0 proj-cmp)))

(defn- deposit-kv!
  "Accumulate [k v] pairs onto branch `b`'s slot `i` (keyed by b._projCmp for leaves; nil anchor
  marker for branches) and delta-update b._bufEntries. Skips leaf-diff map when anchor is nil."
  [^Branch b storage ^long i kvs anchor0]
  (let [^objects ss (or (.-_slots b)
                        (let [a (object-array (alength (.-_keys b)))]
                          (set! (.-_slots b) a) a))
        ^Slot prev (aget ss i)
        anchor (if (and prev (some? (.-anchor prev))) (.-anchor prev) anchor0)
        c (node-child b storage i)
        lvl (.-_level b)
        pcmp (.-_projCmp b)
        diff (cond
               (nil? anchor) nil
               (== lvl 1)
               (let [pd (when prev (.-diff prev))
                     d (cond
                         (sorted? pd) pd
                         (map? pd) (let [d0 (reduce (fn [acc el] (assoc acc el ABSENT))
                                                    (sorted-map-by pcmp) (:absent pd))]
                                     (reduce (fn [acc el] (assoc acc el el)) d0 (:present pd)))
                         :else (sorted-map-by pcmp))]
                 (reduce (fn [acc [k v]] (assoc acc k v)) d kvs))
               :else nil)
        sc (subtree-count c)
        cnt (if (>= sc 0) sc (node-count c storage))
        new-be (cond
                 (nil? anchor) 0
                 (== lvl 1) (long (count diff))
                 :else (buf-entries ^Branch c))
        cur (buf-entries b)
        old-be (if prev (slot-be prev (dec lvl)) 0)]
    (aset ss i (Slot. diff cnt nil anchor new-be))
    (when-not (== cur BUF_WRITE)
      (set! (.-_bufEntries b)
            (if (== new-be BUF_WRITE) BUF_WRITE (+ (- cur old-be) new-be))))
    nil))

(defn- deposit-into! [^Branch b storage ^long i map-key val anchor0]
  (deposit-kv! b storage i [[map-key val]] anchor0))

(defn- deposit-replace! [^Branch b storage ^long i old-key new-key anchor0]
  (deposit-kv! b storage i [[old-key ABSENT] [new-key new-key]] anchor0))

(defn- carry-slots! [^Branch dst ^objects src-slots]
  (when (some? src-slots)
    (let [cap (alength (.-_keys dst))
          arr (object-array cap)
          m (min (.-_len dst) (alength src-slots))]
      (acopy src-slots 0 m arr 0)
      (set! (.-_slots dst) arr))))

(defn- carry-and-deposit! [^Branch dst ^Branch src storage ^long i map-key val anchor0]
  (set! (.-_bufEntries dst) (buf-entries src))
  (carry-slots! dst (.-_slots src))
  (deposit-into! dst storage i map-key val anchor0))

(defn- carry-and-deposit-replace! [^Branch dst ^Branch src storage ^long i old-key new-key anchor0]
  (set! (.-_bufEntries dst) (buf-entries src))
  (carry-slots! dst (.-_slots src))
  (deposit-replace! dst storage i old-key new-key anchor0))

(defn- stitch-slots
  "Carry surviving sibling slots when child `ins` was replaced by `n-nodes` new nodes."
  [^Branch b ^long ins ^long n-nodes ^long new-len]
  (when-let [^objects ss (.-_slots b)]
    (let [out (object-array new-len)
          len (.-_len b)]
      (stitch ss 0 ins out 0)
      (stitch ss (inc ins) len out (+ ins n-nodes))
      out)))

(defn- free-dropped-child
  "Free child i's durable address (addresses[i] or parked slot anchor) on a structural rebuild."
  [^Branch b storage ^long i]
  (when storage
    (let [as (.-_addresses b)
          a (when as (aget as i))]
      (if (some? a)
        (.markFreed ^IStorage storage a)
        (when-let [^Slot sl (slot-at b i)]
          (when-let [anc (.-anchor sl)]
            (.markFreed ^IStorage storage anc)))))))

(defn- refresh-marker-slots!
  "Detect any shared branch child settled by another version and poison its marker slot to -1
  so Pass 1 flushes it with a fresh coherent anchor (matches upstream Branch.refreshMarkerSlots)."
  [^Branch b]
  (when-let [^objects ss (.-_slots b)]
    (when-let [^objects cs (.-_children b)]
      (let [n (.-_len b)
            clvl (dec (.-_level b))]
        (loop [i 0 poisoned? false]
          (if (>= i n)
            (when poisoned? (set! (.-_bufEntries b) BUF_WRITE))
            (let [^Slot sl (aget ss i)]
              (if (or (nil? sl) (some? (.-diff sl)) (nil? (.-anchor sl))
                      (== (.-bufEntries sl) BUF_WRITE))
                (recur (inc i) poisoned?)
                (let [c (aget cs i)]
                  (if-not (branch? c)
                    (recur (inc i) poisoned?)
                    (do
                      (refresh-marker-slots! c)
                      (if (== (buf-entries c) (slot-be sl clvl))
                        (recur (inc i) poisoned?)
                        (do (aset ss i (Slot. (.-diff sl) (.-count sl) (.-measure sl)
                                              (.-anchor sl) BUF_WRITE))
                            (recur (inc i) true))))))))))))))

(defn- assemble-nested
  "Assemble branch `c`'s serializable nested diff {idx -> {:count :measure :diff :max-key}}."
  [storage ^Branch c]
  (let [^objects ss (.-_slots c)]
    (if (nil? ss)
      {}
      (let [n (.-_len c)
            ^objects ks (.-_keys c)
            leaf-parent? (== (.-_level c) 1)]
        (loop [j 0 m {}]
          (if (>= j n)
            m
            (let [^Slot sl (aget ss j)]
              (if (or (nil? sl) (nil? (.-anchor sl)))
                (recur (inc j) m)
                (let [sd (.-diff sl)
                      d (if (some? sd)
                          (if leaf-parent? (leaf-diff->storage sd) sd)
                          (assemble-nested storage (node-child c storage j)))
                      entry {:count (.-count sl)
                             :measure (.-measure sl)
                             :diff d
                             :max-key (aget ks j)}]
                  (recur (inc j) (assoc m j entry)))))))))))

(defn- branch-slots-for-storage
  "Serializable slots map {idx -> {:count :measure :diff :max-key}} for Branch `b`, or nil."
  [^Branch b]
  (when-let [^objects ss (.-_slots b)]
    (let [n (.-_len b)
          ^objects ks (.-_keys b)
          leaf-parent? (== (.-_level b) 1)]
      (loop [i 0 m {}]
        (if (>= i n)
          (when (pos? (count m)) m)
          (let [^Slot sl (aget ss i)]
            (if (nil? sl)
              (recur (inc i) m)
              (recur (inc i)
                     (assoc m i {:count (.-count sl)
                                 :measure (.-measure sl)
                                 :diff (if leaf-parent?
                                         (leaf-diff->storage (.-diff sl))
                                         (.-diff sl))
                                 :max-key (aget ks i)})))))))))

(defn- branch-store [^Branch this storage]
  (let [len (.-_len this)
        cap (alength (.-_keys this))
        addrs (if-let [as (.-_addresses this)]
                (java.util.Arrays/copyOf as cap)
                (object-array cap))]
    (if-not (diff-buf? this)
      ;; baseline (diff-buf-size == 0): byte-identical (I0)
      (do
        (let [^objects cs (.-_children this)]
          (dotimes [i len]
            (when (nil? (aget addrs i))
              (aset addrs i (.store ^INode (aget cs i) storage)))))
        (set! (.-_addresses this) addrs)
        (when (settings-weak? (.-_settings this)) (set! (.-_children this) nil))
        (.store ^IStorage storage this))
      ;; diff-buf store: buffer smallest content-only dirty children up to budget B, flush largest
      (do
        (refresh-marker-slots! this)
        (let [budget (.-_diffBufSize ^Settings (.-_settings this))
              clvl (dec (.-_level this))
              ^objects cs (.-_children this)
              ^objects ss (when-let [s0 (.-_slots this)]
                            (java.util.Arrays/copyOf s0 cap))
              ;; Pass 1: sum clean passthrough; classify dirty children in O(1) via slot-be
              {:keys [pass buf wl]}
              (loop [i 0 pass 0 buf [] wl []]
                (if (>= i len)
                  {:pass pass :buf buf :wl wl}
                  (let [^Slot sl (when ss (aget ss i))]
                    (if (some? (aget addrs i))
                      (recur (inc i) (if sl (+ pass (slot-be sl clvl)) pass) buf wl)
                      (let [child (aget cs i)]
                        (cond
                          (or (nil? sl) (nil? (.-anchor sl)))
                          (recur (inc i) pass buf (clojure.core/conj wl i))
                          (== (.-bufEntries sl) BUF_WRITE)
                          (recur (inc i) pass buf (clojure.core/conj wl i))
                          :else
                          (let [sd (.-diff sl)
                                nested (if (some? sd) sd (assemble-nested storage child))
                                sz (slot-be sl clvl)]
                            (recur (inc i) pass (clojure.core/conj buf {:i i :sz sz :nested nested}) wl))))))))
              ;; Pass 2: buffer smallest-first while running total <= budget; flush the rest
              [embedded flushed]
              (reduce (fn [[^long emb wl] {:keys [i sz nested]}]
                        (if (<= (+ emb (long sz)) budget)
                          (let [^Slot sl (aget ss i)
                                anc (.-anchor sl)]
                            (aset addrs i anc)
                            (aset ss i (Slot. nested (.-count sl) (.-measure sl) anc (long sz)))
                            [(+ emb (long sz)) wl])
                          [emb (clojure.core/conj wl i)]))
                      [pass wl]
                      (sort-by :sz buf))
              ;; D3: cap over-budget passthrough (from branch merge/borrow) biggest-first
              embedded
              (if (and ss (> (long embedded) budget))
                (let [cands (->> (range len)
                                 (filter (fn [i] (and (some? (aget addrs i)) (some? (aget ss i)))))
                                 (sort-by (fn [i] (- (slot-be (aget ss i) clvl)))))]
                  (loop [emb (long embedded) ks (seq cands)]
                    (if (or (<= emb budget) (nil? ks))
                      emb
                      (let [i (int (first ks))
                            ^Slot sl (aget ss i)
                            c (or (when cs (aget cs i))
                                  (let [base0 (.restore ^IStorage storage (aget addrs i))
                                        base (if-let [pc (.-_projCmp this)] (stamp-proj-cmp base0 pc) base0)]
                                    (if (some? (.-diff sl))
                                      (if (leaf? base)
                                        (project-leaf base (.-diff sl) (.-_projCmp this))
                                        (project-branch base sl (.-_projCmp this)))
                                      base)))]
                        (.markFreed ^IStorage storage (aget addrs i))
                        (aset addrs i (.store ^INode c storage))
                        (aset ss i nil)
                        (recur (- emb (slot-be sl clvl)) (next ks))))))
                (long embedded))]
          ;; Pass 3: write flushed / structural children (all resident -> no read)
          (doseq [i flushed]
            (let [i (int i)
                  child (aget cs i)
                  ^Slot sl (when ss (aget ss i))]
              (when (and sl (.-anchor sl))
                (.markFreed ^IStorage storage (.-anchor sl)))
              (aset addrs i (.store ^INode child storage))
              (when ss (aset ss i nil))))
          (set! (.-_addresses this) addrs)
          (set! (.-_slots this) (when (and ss (pos? embedded)) ss))
          (set! (.-_bufEntries this) embedded)
          (let [a (.store ^IStorage storage this)]
            (when (settings-weak? (.-_settings this)) (set! (.-_children this) nil))
            a))))))

;; ---------------------------------------------------------------------------
;; contains / lookup

(defn- node-contains? [n storage key cmp]
  (let [keys (node-keys n) len (node-len n)
        idx (search keys len key cmp)]
    (cond
      (>= idx 0) true
      (leaf? n) false
      :else (let [ins (- (inc idx))]
              (if (== ins len) false (recur (node-child n storage ins) storage key cmp))))))

;; ---------------------------------------------------------------------------
;; add

(defn- leaf-add [^Leaf leaf storage key cmp ^Settings settings]
  (let [keys (.-_keys leaf) len (.-_len leaf)
        idx (search keys len key cmp)]
    (if (>= idx 0)
      UNCHANGED
      (let [ins (- (inc idx))]
        (if (and (settings-editable? (.-_settings leaf)) (< len (alength keys)))
          (do (acopy keys ins len keys (inc ins))
              (aset keys ins key)
              (set! (.-_len leaf) (inc len))
              (if (== ins len) (object-array [leaf]) EARLY_EXIT))
          (let [total (inc len)
                bf (.-_branchingFactor settings)]
            (if (<= total bf)
              (let [n (leaf-of-len total settings) nk (.-_keys n)]
                (acopy keys 0 ins nk 0)
                (aset nk ins key)
                (acopy keys ins len nk (inc ins))
                (object-array [n]))
              ;; opt-in right-edge leaf append: keep full left leaf intact (preserving its
              ;; content-addressed UUID when stored & unbuffered) and start a 1-key right leaf
              (if (and (settings-edge-append? settings) (== ins len))
                (let [l2 (leaf-of-len 1 settings)]
                  (aset (.-_keys l2) 0 key)
                  (object-array [leaf l2]))
                ;; count boundary at level 0: ceil(total/bf) leaves of near-equal length (2 here)
                (let [all (object-array total)
                      _ (do (acopy keys 0 ins all 0) (aset all ins key) (acopy keys ins len all (inc ins)))
                      half1 (unsigned-bit-shift-right total 1)
                      l1 (leaf-of-len half1 settings)
                      l2 (leaf-of-len (- total half1) settings)]
                  (acopy all 0 half1 (.-_keys l1) 0)
                  (acopy all half1 total (.-_keys l2) 0)
                  (object-array [l1 l2]))))))))))

(declare node-add)

(defn- branch-add [^Branch b storage key cmp ^Settings settings]
  (let [keys (.-_keys b) len (.-_len b)
        idx (search keys len key cmp)]
    (if (>= idx 0)
      UNCHANGED
      (let [ins (let [i (- (inc idx))] (if (== i len) (dec len) i))
            as (.-_addresses b)
            dbuf? (settings-diff-buf? settings)
            anchor0 (when (and dbuf? as) (aget as ins))
            old-child (node-child b storage ins)
            old-cc (subtree-count old-child)
            nodes (node-add old-child storage key cmp settings)
            cnt (.-_subtreeCount b)]
        (cond
          (identical? nodes UNCHANGED) UNCHANGED

          (identical? nodes EARLY_EXIT)
          (do (when (>= cnt 0) (set! (.-_subtreeCount b) (inc cnt)))
              (when (and (not dbuf?) storage as (aget as ins))
                (.markFreed ^IStorage storage (aget as ins)))
              (set-child! b ins old-child)
              (when dbuf? (deposit-into! b storage ins key key anchor0))
              EARLY_EXIT)

          (== 1 (alength nodes))
          (let [node (aget nodes 0)
                nc (subtree-count node)
                new-cnt (if (and (>= cnt 0) (>= old-cc 0) (>= nc 0)) (+ (- cnt old-cc) nc) -1)]
            (when (and (not dbuf?) storage as (aget as ins))
              (.markFreed ^IStorage storage (aget as ins)))
            (if (settings-editable? (.-_settings b))
              (do (aset keys ins (node-max-key node))
                  (set-child! b ins node)
                  (set! (.-_subtreeCount b) new-cnt)
                  (when dbuf? (deposit-into! b storage ins key key anchor0))
                  (if (== ins (dec len)) (object-array [b]) EARLY_EXIT))
              (let [nk (java.util.Arrays/copyOfRange keys 0 len)
                    _ (aset nk ins (node-max-key node))
                    na (when as
                         (let [a (java.util.Arrays/copyOfRange as 0 len)] (aset a ins nil) a))
                    nch (let [cs (.-_children b)
                              a (if cs (java.util.Arrays/copyOfRange cs 0 len) (object-array len))]
                          (aset a ins node) a)
                    nb (new-branch (.-_level b) len nk na nch new-cnt settings (.-_projCmp b))]
                (when dbuf? (carry-and-deposit! nb b storage ins key key anchor0))
                (object-array [nb]))))

          :else
          (let [n0 (aget nodes 0) n1 (aget nodes 1)
                ;; If right-edge leaf append kept the full left leaf identical & it had no buffered
                ;; slot, its durable address is still valid on disk — keep it and do not markFreed.
                keep-left-addr? (and as (some? (aget as ins))
                                     (identical? n0 old-child)
                                     (nil? (slot-at b ins)))
                c01 (let [x (subtree-count n0) y (subtree-count n1)] (if (or (neg? x) (neg? y)) -1 (+ x y)))
                new-cnt (if (and (>= cnt 0) (>= old-cc 0) (>= c01 0)) (+ (- cnt old-cc) c01) -1)
                total (inc len)
                all-k (object-array total)
                all-a (when as (object-array total))
                all-c (object-array total)
                cs (.-_children b)]
            (when-not keep-left-addr?
              (if dbuf?
                (free-dropped-child b storage ins)
                (when (and storage as (aget as ins))
                  (.markFreed ^IStorage storage (aget as ins)))))
            (stitch keys 0 ins all-k 0)
            (aset all-k ins (node-max-key n0)) (aset all-k (inc ins) (node-max-key n1))
            (stitch keys (inc ins) len all-k (+ ins 2))
            (when all-a
              (stitch as 0 ins all-a 0)
              (when keep-left-addr? (aset all-a ins (aget as ins)))
              (stitch as (inc ins) len all-a (+ ins 2)))
            (when cs
              (stitch cs 0 ins all-c 0)
              (stitch cs (inc ins) len all-c (+ ins 2)))
            (aset all-c ins n0) (aset all-c (inc ins) n1)
            (if (<= total (.-_branchingFactor settings))
              (let [nb (new-branch (.-_level b) total all-k all-a all-c new-cnt settings (.-_projCmp b))]
                (when dbuf?
                  (install-slots! nb (stitch-slots b ins (alength nodes) total) BUF_WRITE))
                (object-array [nb]))
              (let [half1 (unsigned-bit-shift-right total 1)
                    half2 (- total half1)
                    k1 (java.util.Arrays/copyOfRange all-k 0 half1)
                    k2 (java.util.Arrays/copyOfRange all-k half1 total)
                    a1 (when all-a (java.util.Arrays/copyOfRange all-a 0 half1))
                    a2 (when all-a (java.util.Arrays/copyOfRange all-a half1 total))
                    ch1 (java.util.Arrays/copyOfRange all-c 0 half1)
                    ch2 (java.util.Arrays/copyOfRange all-c half1 total)
                    b1 (new-branch (.-_level b) half1 k1 a1 ch1 (children-count ch1 half1) settings (.-_projCmp b))
                    b2 (new-branch (.-_level b) half2 k2 a2 ch2 (children-count ch2 half2) settings (.-_projCmp b))]
                (when dbuf?
                  (let [all-s (stitch-slots b ins (alength nodes) total)]
                    (install-slots! b1 (when all-s (java.util.Arrays/copyOfRange all-s 0 half1)) BUF_WRITE)
                    (install-slots! b2 (when all-s (java.util.Arrays/copyOfRange all-s half1 total)) BUF_WRITE)))
                (object-array [b1 b2])))))))))

(defn- node-add [n storage key cmp settings]
  (if (leaf? n) (leaf-add n storage key cmp settings) (branch-add n storage key cmp settings)))

;; ---------------------------------------------------------------------------
;; remove
;;
;; A node's remove takes its left and right siblings (nil at the edges) and returns
;; [left' center' right'] (nil = that node was merged away), or UNCHANGED, or EARLY_EXIT.
;; Rebalancing works on "entries": keys for a leaf; (key, address, child, slot) for a branch.

(defn- entries-of
  "[keys addresses children slots len] of node n (addresses/children/slots nil for a leaf)."
  [n]
  (if (leaf? n)
    [(.-_keys ^Leaf n) nil nil nil (.-_len ^Leaf n)]
    [(.-_keys ^Branch n) (.-_addresses ^Branch n) (.-_children ^Branch n) (.-_slots ^Branch n) (.-_len ^Branch n)]))

(defn- build-node
  "A node like `proto` (leaf or branch at its level) from entries ks/as/cs/ss [from,to) concatenated."
  [proto parts settings]
  (let [total (reduce + 0 (map (fn [[_ _ _ _ from to]] (- to from)) parts))
        leaf (leaf? proto)
        cap (new-len total settings)
        nk (object-array cap)
        na (when (and (not leaf) (some (fn [[_ as]] as) parts)) (object-array cap))
        nc (when-not leaf (object-array cap))
        ns (when (and (not leaf) (some (fn [[_ _ _ ss]] ss) parts)) (object-array cap))]
    (loop [ps parts pos 0]
      (when-let [[ks as cs ss from to] (first ps)]
        (stitch ks from to nk pos)
        (when na (stitch as from to na pos))
        (when nc (stitch cs from to nc pos))
        (when ns (stitch ss from to ns pos))
        (recur (rest ps) (+ pos (- to from)))))
    (if leaf
      (Leaf. total nk settings)
      (Branch. (.-_level ^Branch proto) total nk na nc (children-count nc total)
               settings ns 0 (.-_projCmp ^Branch proto)))))

(defn- rebalance
  "Given the new center entries (ks as cs ss len), and this node's siblings left/right, return
   [left' center' right'] per PSS's rules: keep, join with left, join with right, or
   redistribute with the bigger sibling."
  [proto left right [cks cas ccs css clen] settings]
  (let [bf (.-_branchingFactor ^Settings settings)
        minbf (unsigned-bit-shift-right bf 1)
        center-part [cks cas ccs css 0 clen]]
    (cond
      (or (>= clen minbf) (and (nil? left) (nil? right)))
      (object-array [left (build-node proto [center-part] settings) right])

      (and left (<= (+ (node-len left) clen) bf))
      (let [[lk la lc ls ll] (entries-of left)]
        (object-array [nil (build-node proto [[lk la lc ls 0 ll] center-part] settings) right]))

      (and right (<= (+ clen (node-len right)) bf))
      (let [[rk ra rc rs rl] (entries-of right)]
        (object-array [left (build-node proto [center-part [rk ra rc rs 0 rl]] settings) nil]))

      (and left (or (nil? right) (>= (node-len left) (node-len right))))
      (let [[lk la lc ls ll] (entries-of left)
            total (+ ll clen)
            new-left-len (unsigned-bit-shift-right total 1)]
        (object-array [(build-node proto [[lk la lc ls 0 new-left-len]] settings)
                       (build-node proto [[lk la lc ls new-left-len ll] center-part] settings)
                       right]))

      :else
      (let [[rk ra rc rs rl] (entries-of right)
            total (+ clen rl)
            new-center-len (unsigned-bit-shift-right total 1)
            right-head (- new-center-len clen)]
        (object-array [left
                       (build-node proto [center-part [rk ra rc rs 0 right-head]] settings)
                       (build-node proto [[rk ra rc rs right-head rl]] settings)])))))

(defn- leaf-remove [^Leaf leaf storage key left right cmp ^Settings settings removed-out]
  (let [keys (.-_keys leaf) len (.-_len leaf)
        idx (search-first-eq keys len key cmp)]
    (if (neg? idx)
      UNCHANGED
      (let [new-len (dec len)
            minbf (unsigned-bit-shift-right (.-_branchingFactor settings) 1)]
        (when removed-out (aset ^objects removed-out 0 (aget keys idx)))
        (if (and (settings-editable? (.-_settings leaf))
                 (or (>= new-len minbf) (and (nil? left) (nil? right))))
          (do (acopy keys (inc idx) len keys idx)
              (aset keys new-len nil)
              (set! (.-_len leaf) new-len)
              (if (== idx new-len) (object-array [left leaf right]) EARLY_EXIT))
          (let [ck (object-array new-len)]
            (acopy keys 0 idx ck 0)
            (acopy keys (inc idx) len ck idx)
            (rebalance leaf left right [ck nil nil nil new-len] settings)))))))

(declare node-remove)

(defn- branch-remove [^Branch b storage key left right cmp ^Settings settings]
  (let [keys (.-_keys b) len (.-_len b)
        idx (search-first keys len key cmp)]
    (if (== idx len)
      UNCHANGED
      (let [as (.-_addresses b)
            dbuf? (settings-diff-buf? settings)
            anchor0 (when (and dbuf? as) (aget as idx))
            lchild (when (> idx 0) (node-child b storage (dec idx)))
            rchild (when (< idx (dec len)) (node-child b storage (inc idx)))
            llen (if lchild (node-len lchild) -1)
            rlen (if rchild (node-len rchild) -1)
            child (node-child b storage idx)
            removed-out (when (and dbuf? (== 1 (.-_level b))) (object-array 1))
            nodes (node-remove child storage key lchild rchild cmp settings removed-out)
            removed-key (if-some [r (and removed-out (aget ^objects removed-out 0))] r key)
            cnt (.-_subtreeCount b)]
        (cond
          (identical? nodes UNCHANGED) UNCHANGED
          (identical? nodes EARLY_EXIT)
          (do (when (>= cnt 0) (set! (.-_subtreeCount b) (dec cnt)))
              (when (and (not dbuf?) storage as (aget as idx))
                (.markFreed ^IStorage storage (aget as idx)))
              (set-child! b idx child)
              (when dbuf? (deposit-into! b storage idx removed-key ABSENT anchor0))
              EARLY_EXIT)
          :else
          (let [n0 (aget nodes 0) n1 (aget nodes 1) n2 (aget nodes 2)
                lchanged (or (not (identical? lchild n0)) (not= llen (if n0 (node-len n0) -1)))
                rchanged (or (not (identical? rchild n2)) (not= rlen (if n2 (node-len n2) -1)))
                cs (.-_children b)
                ss (.-_slots b)
                start (max 0 (dec idx))
                end (min len (+ idx 2))
                mid-n (+ (if n0 1 0) 1 (if n2 1 0))
                clen (+ start mid-n (- len end))
                content-only? (and (not lchanged) (not rchanged) (== clen len))
                ck (object-array clen) ca (when as (object-array clen)) cc (object-array clen)
                css (when ss (object-array clen))]
            (when (and (not dbuf?) storage as)
              (when (aget as idx) (.markFreed ^IStorage storage (aget as idx)))
              (when (and lchanged (> idx 0) (aget as (dec idx)))
                (.markFreed ^IStorage storage (aget as (dec idx))))
              (when (and rchanged (< idx (dec len)) (aget as (inc idx)))
                (.markFreed ^IStorage storage (aget as (inc idx)))))
            (stitch keys 0 start ck 0)
            (when ca (stitch as 0 start ca 0))
            (when cs (stitch cs 0 start cc 0))
            (when css (stitch ss 0 start css 0))
            (loop [pos start
                   quads [[n0
                           (when (and as (not lchanged) (> idx 0)) (aget as (dec idx)))
                           (when (and ss (not lchanged) (> idx 0)) (aget ss (dec idx)))]
                          [n1
                           nil
                           (when (and ss content-only?) (aget ss idx))]
                          [n2
                           (when (and as (not rchanged) (< idx (dec len))) (aget as (inc idx)))
                           (when (and ss (not rchanged) (< idx (dec len))) (aget ss (inc idx)))]]]
              (if-let [[n a sl] (first quads)]
                (if n
                  (do (aset ck pos (node-max-key n))
                      (when ca (aset ca pos a))
                      (aset cc pos n)
                      (when css (aset css pos sl))
                      (recur (inc pos) (rest quads)))
                  (recur pos (rest quads)))
                (do (stitch keys end len ck pos)
                    (when ca (stitch as end len ca pos))
                    (when cs (stitch cs end len cc pos))
                    (when css (stitch ss end len css pos)))))
            (let [r (rebalance b left right [ck ca cc css clen] settings)
                  r0 (aget r 0) c (aget r 1) r2 (aget r 2)
                  no-parent-rebalance? (and (identical? r0 left) (identical? r2 right))]
              ;; the rebuilt center's count by delta (upstream 0.5.145, Branch.remove): this node
              ;; less the one removed element, plus a sibling it joined, whose count is carried
              ;; whole. build-node sums children, which is unknown (-1) when one is not in memory,
              ;; as after a cold restore; a redistribution with a sibling keeps that sum.
              (when (and (branch? c) (>= cnt 0))
                (cond
                  no-parent-rebalance?
                  (set! (.-_subtreeCount ^Branch c) (dec cnt))

                  (and left (nil? r0) (>= (subtree-count left) 0))
                  (set! (.-_subtreeCount ^Branch c) (+ (subtree-count left) (dec cnt)))

                  (and right (nil? r2) (>= (subtree-count right) 0))
                  (set! (.-_subtreeCount ^Branch c) (+ (dec cnt) (subtree-count right)))))
              (when dbuf?
                (if (and content-only? no-parent-rebalance?)
                  (do (set! (.-_bufEntries ^Branch c) (buf-entries b))
                      (deposit-into! c storage idx removed-key ABSENT anchor0))
                  (do
                    (when-not content-only?
                      (free-dropped-child b storage idx)
                      (when (and lchanged (> idx 0)) (free-dropped-child b storage (dec idx)))
                      (when (and rchanged (< idx (dec len))) (free-dropped-child b storage (inc idx))))
                    (when (branch? c) (set! (.-_bufEntries ^Branch c) BUF_WRITE))
                    (when (and (branch? r0) (not (identical? r0 left)))
                      (set! (.-_bufEntries ^Branch r0) BUF_WRITE))
                    (when (and (branch? r2) (not (identical? r2 right)))
                      (set! (.-_bufEntries ^Branch r2) BUF_WRITE)))))
              r)))))))

(defn- node-remove
  ([n storage key left right cmp settings]
   (node-remove n storage key left right cmp settings nil))
  ([n storage key left right cmp settings removed-out]
   (if (leaf? n)
     (leaf-remove n storage key left right cmp settings removed-out)
     (branch-remove n storage key left right cmp settings))))

;; ---------------------------------------------------------------------------
;; replace (oldKey and newKey compare equal under cmp)

(defn- node-replace
  ([n storage old-key new-key cmp settings]
   (node-replace n storage old-key new-key cmp settings nil))
  ([n storage old-key new-key cmp settings removed-out]
   (let [keys (node-keys n) len (node-len n)]
     (if (leaf? n)
       (let [idx (search-first-eq keys len old-key cmp)]
         (if (neg? idx)
           UNCHANGED
           (do
             (when removed-out (aset ^objects removed-out 0 (aget keys idx)))
             (if (node-editable? n)
               (do (aset keys idx new-key)
                   (if (== idx (dec len)) (object-array [n]) EARLY_EXIT))
               (let [nl (leaf-of-len len settings)]
                 (acopy keys 0 len (.-_keys nl) 0)
                 (aset (.-_keys nl) idx new-key)
                 (object-array [nl]))))))
       (let [^Branch b n
             idx (search-first keys len old-key cmp)]
         (if (== idx len)
           UNCHANGED
           (let [as (.-_addresses b)
                 dbuf? (settings-diff-buf? settings)
                 anchor0 (when (and dbuf? as) (aget as idx))
                 child (node-child b storage idx)
                 sub-out (when (and dbuf? (== 1 (.-_level b))) (object-array 1))
                 nodes (node-replace child storage old-key new-key cmp settings sub-out)
                 removed-key (if-some [r (and sub-out (aget ^objects sub-out 0))] r old-key)]
             (cond
               (identical? nodes UNCHANGED) nodes
               (identical? nodes EARLY_EXIT)
               (do (when (and (not dbuf?) storage as (aget as idx))
                     (.markFreed ^IStorage storage (aget as idx)))
                   (set-child! b idx child)
                   (when dbuf? (deposit-replace! b storage idx removed-key new-key anchor0))
                   EARLY_EXIT)
               :else
               (let [node (aget nodes 0)]
                 (when (and (not dbuf?) storage as (aget as idx))
                   (.markFreed ^IStorage storage (aget as idx)))
                 (if (node-editable? b)
                   (do (aset keys idx (node-max-key node))
                       (set-child! b idx node)
                       (when dbuf? (deposit-replace! b storage idx removed-key new-key anchor0))
                       (if (== idx (dec len)) (object-array [b]) EARLY_EXIT))
                   (let [nk (java.util.Arrays/copyOfRange keys 0 len)
                         na (when as (java.util.Arrays/copyOfRange as 0 len))
                         nc (if-let [cs (.-_children b)] (java.util.Arrays/copyOfRange cs 0 len) (object-array len))
                         _ (do (aset nk idx (node-max-key node))
                               (when na (aset na idx nil))
                               (aset nc idx node))
                         nb (new-branch (.-_level b) len nk na nc (.-_subtreeCount b) settings (.-_projCmp b))]
                     (when dbuf? (carry-and-deposit-replace! nb b storage idx removed-key new-key anchor0))
                     (object-array [nb]))))))))))))

;; ---------------------------------------------------------------------------
;; Seq: a cursor stack (parent = the Seq one level up, positioned at this node).

(declare ->seq-slice ->seq-rslice seq-advance seq-reduce at-beginning? at-end? set-storage)

(defn- seek-outside?
  "Is `to` outside node's key range, on either side (a seek climbs past such a node)?"
  [node to cmp]
  (or (neg? (long (cmp (node-max-key node) to)))
      (neg? (long (cmp to (aget (node-keys node) 0))))))

(deftype Seq [_meta _set _parent _node ^long _idx _keyTo _cmp _asc ^long _version _leafSafe]
  clojure.lang.ISeq
  (first [_] (read-key (set-storage _set) (node-keys _node) _idx))
  (next [this] (seq-advance this))
  (more [this] (or (seq-advance this) ()))
  (cons [this o] (clojure.lang.Cons. o this))
  clojure.lang.Seqable
  (seq [this] this)
  clojure.lang.Sequential
  clojure.lang.IPersistentCollection
  ;; folded over the leaf arrays (seq-reduce): stepping built a Seq per element, 464 B each
  (count [this] (seq-reduce this (fn [n _] (inc n)) 0))
  (empty [_] ())
  (equiv [this o] (= (seq (vec this)) (seq o)))
  clojure.lang.IMeta
  (meta [_] _meta)
  clojure.lang.IObj
  (withMeta [_ m] (Seq. m _set _parent _node _idx _keyTo _cmp _asc _version _leafSafe))
  clojure.lang.IReduceInit
  (reduce [this f init] (seq-reduce this f init))
  clojure.lang.IReduce
  (reduce [this f]
    (let [n (seq-advance this)]
      (let [k (read-key (set-storage _set) (node-keys _node) _idx)]
        (if n (seq-reduce n f k) k))))
  clojure.lang.Reversible
  (rseq [this]
    (if _asc
      (.rslice ^IPersistentSortedSet _set _keyTo (when-not (at-beginning? this) (.first this)) _cmp)
      (.slice ^IPersistentSortedSet _set _keyTo (when-not (at-end? this) (.first this)) _cmp)))
  ISeek
  (seek [this to] (.seek this to _cmp))
  (seek [this to cmp]
    (when (nil? to) (throw (ex-info "seek can't be called with a nil key!" {})))
    ;; climb while `to` is outside this node's subtree on EITHER side (upstream Seq.seek, 0.5.145):
    ;; testing only the direction of travel left a backward seek inside the current leaf
    (if _asc
      (loop [seq _parent node _node]
        (if (and seq (seek-outside? node to cmp))
          (recur (.-_parent ^Seq seq) (.-_node ^Seq seq))
          (when-not (neg? (long (cmp (node-max-key node) to)))
            (->seq-slice _set seq node to _keyTo cmp _version))))
      (loop [seq _parent node _node]
        (if (and seq (seek-outside? node to cmp))
          (recur (.-_parent ^Seq seq) (.-_node ^Seq seq))
          (->seq-rslice _set seq node to _keyTo cmp _version)))))
  Object
  (toString [this] (str (apply list this))))

(defn- seq-over? [^Seq s]
  (let [kt (.-_keyTo s)]
    (if (nil? kt)
      false
      (let [d (long ((.-_cmp s) (aget (node-keys (.-_node s)) (.-_idx s)) kt))]
        (if (.-_asc s) (pos? d) (neg? d))))))

(defn- leaf-safe? [node key-to cmp asc]
  (or (nil? key-to) (nil? cmp)
      (if asc
        (<= (long (cmp (node-max-key node) key-to)) 0)
        (>= (long (cmp (aget (node-keys node) 0) key-to)) 0))))

(defn- mk-seq [set parent node idx key-to cmp asc version]
  (Seq. nil set parent node idx key-to cmp asc version (leaf-safe? node key-to cmp asc)))

(defn- seq-storage [^Seq s] (.-_storage ^PersistentSortedSet (.-_set s)))

(defn- check-version [^Seq s]
  (when-not (== (.-_version s) (long (.-_version ^PersistentSortedSet (.-_set s))))
    (throw (ex-info "Tovarisch, you are iterating and mutating a transient set at the same time!" {}))))

(defn- seq-advance
  "The Seq one step further (asc or desc), or nil at the end or past _keyTo."
  [^Seq s]
  (check-version s)
  (let [node (.-_node s) idx (.-_idx s) asc (.-_asc s) len (node-len node)]
    (if asc
      (if (< idx (dec len))
        (let [n (Seq. nil (.-_set s) (.-_parent s) node (inc idx) (.-_keyTo s) (.-_cmp s) true (.-_version s) (.-_leafSafe s))]
          (when (or (.-_leafSafe s) (not (seq-over? n))) n))
        (when-let [p (.-_parent s)]
          (when-let [p' (seq-advance p)]
            (let [child (node-child (.-_node ^Seq p') (seq-storage s) (.-_idx ^Seq p'))
                  n (mk-seq (.-_set s) p' child 0 (.-_keyTo s) (.-_cmp s) true (.-_version s))]
              (when (or (.-_leafSafe ^Seq n) (not (seq-over? n))) n)))))
      (if (> idx 0)
        (let [n (Seq. nil (.-_set s) (.-_parent s) node (dec idx) (.-_keyTo s) (.-_cmp s) false (.-_version s) (.-_leafSafe s))]
          (when (or (.-_leafSafe s) (not (seq-over? n))) n))
        (when-let [p (.-_parent s)]
          (when-let [p' (seq-advance p)]
            (let [child (node-child (.-_node ^Seq p') (seq-storage s) (.-_idx ^Seq p'))
                  n (mk-seq (.-_set s) p' child (dec (node-len child)) (.-_keyTo s) (.-_cmp s) false (.-_version s))]
              (when (or (.-_leafSafe ^Seq n) (not (seq-over? n))) n))))))))

(defn- seq-reduce
  "reduce f over this seq's remaining keys, walking leaf arrays directly."
  [^Seq s f init]
  (loop [^Seq s s acc init]
    (if (nil? s)
      acc
      (let [node (.-_node s) keys (node-keys node) len (node-len node)
            kt (.-_keyTo s) cmp (.-_cmp s) safe (.-_leafSafe s) st (set-storage (.-_set s))]
        (if (.-_asc s)
          (let [[acc stop?]
                (loop [i (.-_idx s) acc acc]
                  (if (< i len)
                    (let [k (aget keys i)]
                      (if (and (not safe) kt (pos? (long (cmp k kt))))
                        [acc true]
                        (let [acc (f acc (read-key st keys i))]
                          (if (reduced? acc) [acc true] (recur (inc i) acc)))))
                    [acc false]))]
            (if stop?
              (unreduced acc)
              (recur (when-let [p (.-_parent s)]
                       (when-let [p' (seq-advance p)]
                         (mk-seq (.-_set s) p' (node-child (.-_node ^Seq p') (seq-storage s) (.-_idx ^Seq p'))
                                 0 kt cmp true (.-_version s))))
                     acc)))
          (let [[acc stop?]
                (loop [i (.-_idx s) acc acc]
                  (if (>= i 0)
                    (let [k (aget keys i)]
                      (if (and (not safe) kt (neg? (long (cmp k kt))))
                        [acc true]
                        (let [acc (f acc (read-key st keys i))]
                          (if (reduced? acc) [acc true] (recur (dec i) acc)))))
                    [acc false]))]
            (if stop?
              (unreduced acc)
              (recur (when-let [p (.-_parent s)]
                       (when-let [p' (seq-advance p)]
                         (let [c (node-child (.-_node ^Seq p') (seq-storage s) (.-_idx ^Seq p'))]
                           (mk-seq (.-_set s) p' c (dec (node-len c)) kt cmp false (.-_version s)))))
                     acc))))))))

(defn- at-beginning? [^Seq s]
  (and (zero? (.-_idx s)) (or (nil? (.-_parent s)) (at-beginning? (.-_parent s)))))
(defn- at-end? [^Seq s]
  (and (== (.-_idx s) (dec (node-len (.-_node s)))) (or (nil? (.-_parent s)) (at-end? (.-_parent s)))))

(defn- ->seq-slice
  "Descend from node (under parent seq) to the first key >= from; nil if none or past key-to."
  [set parent node from key-to cmp version]
  (let [storage (.-_storage ^PersistentSortedSet set)]
    (loop [seq parent node node]
      (let [idx (if (nil? from) 0 (search-first (node-keys node) (node-len node) from cmp))]
        (if (== idx (node-len node))
          nil
          (if (branch? node)
            (let [s (Seq. nil set seq node idx nil nil true version true)]
              (recur s (node-child node storage idx)))
            (let [s (mk-seq set seq node idx key-to cmp true version)]
              (when-not (seq-over? s) s))))))))

(defn- ->seq-rslice
  "Descend to the last key <= from (from nil = the last key); nil if none or past key-to."
  [set parent node from key-to cmp version]
  (let [storage (.-_storage ^PersistentSortedSet set)]
    (loop [seq parent node node]
      (let [len (node-len node)]
        (if (branch? node)
          (let [idx (if (nil? from) (dec len)
                        (let [i (inc (search-last (node-keys node) len from cmp))] (if (== i len) (dec i) i)))
                s (Seq. nil set seq node idx nil nil false version true)]
            (recur s (node-child node storage idx)))
          (if (nil? from)
            (let [s (mk-seq set seq node (dec len) key-to cmp false version)]
              (when-not (seq-over? s) s))
            (let [idx (search-last (node-keys node) len from cmp)]
              (if (== idx -1)
                (seq-advance (mk-seq set seq node 0 key-to cmp false version))
                (let [s (mk-seq set seq node idx key-to cmp false version)]
                  (when-not (seq-over? s) s))))))))))

;; ---------------------------------------------------------------------------
;; ForwardCursor (the JVM fast path of datahike.query.execute)

(deftype ForwardCursor [_set _cmp ^:unsynchronized-mutable _leaf ^:unsynchronized-mutable _leafIdx
                        _branches _branchIdxs _depth]
  IForwardCursor
  (seekGE [this key]
    (when _leaf
      (let [storage (.-_storage ^PersistentSortedSet _set)
            cmp _cmp
            leaf-hit (when (<= (long (cmp key (node-max-key _leaf))) 0)
                       (let [idx (search-first (node-keys _leaf) (node-len _leaf) key cmp)
                             idx (max idx _leafIdx)
                             idx (if (and (< idx (node-len _leaf))
                                          (neg? (long (cmp (aget (node-keys _leaf) idx) key))))
                                   (search-first (node-keys _leaf) (node-len _leaf) key cmp)
                                   idx)]
                         (when (< idx (node-len _leaf))
                           (set! _leafIdx idx)
                           (read-key storage (node-keys _leaf) idx))))]
        (or leaf-hit
            (loop [level (dec _depth)]
              (if (< level 0)
                (do (set! _leaf nil) nil)
                (let [^Branch br (aget _branches level)
                      found (loop [bi (inc (aget _branchIdxs level))]
                              (when (< bi (.-_len br))
                                (if (<= (long (cmp key (aget (.-_keys br) bi))) 0)
                                  (do (aset _branchIdxs level bi)
                                      (let [node (loop [d (inc level) node (node-child br storage bi)]
                                                   (if (< d _depth)
                                                     (let [ci (min (search-first (node-keys node) (node-len node) key cmp)
                                                                   (dec (node-len node)))]
                                                       (aset _branches d node)
                                                       (aset _branchIdxs d ci)
                                                       (recur (inc d) (node-child node storage ci)))
                                                     node))]
                                        (set! _leaf node)
                                        (let [idx (search-first (node-keys node) (node-len node) key cmp)]
                                          (if (< idx (node-len node))
                                            (do (set! _leafIdx idx) (read-key storage (node-keys node) idx))
                                            (recur (inc bi))))))
                                  (recur (inc bi)))))]
                  (or found (recur (dec level))))))))))
  (next [this]
    (when _leaf
      (set! _leafIdx (inc _leafIdx))
      (if (< _leafIdx (node-len _leaf))
        (read-key (set-storage _set) (node-keys _leaf) _leafIdx)
        (let [storage (.-_storage ^PersistentSortedSet _set)]
          (loop [level (dec _depth)]
            (if (< level 0)
              (do (set! _leaf nil) nil)
              (let [bi (inc (aget _branchIdxs level)) ^Branch br (aget _branches level)]
                (if (< bi (.-_len br))
                  (do (aset _branchIdxs level bi)
                      (let [node (loop [d (inc level) node (node-child br storage bi)]
                                   (if (< d _depth)
                                     (do (aset _branches d node) (aset _branchIdxs d 0)
                                         (recur (inc d) (node-child node storage 0)))
                                     node))]
                        (set! _leaf node) (set! _leafIdx 0)
                        (read-key storage (node-keys node) 0)))
                  (recur (dec level))))))))))
  (current [_]
    (when (and _leaf (>= _leafIdx 0) (< _leafIdx (node-len _leaf)))
      (read-key (set-storage _set) (node-keys _leaf) _leafIdx))))

;; ---------------------------------------------------------------------------
;; The set

(declare grow-root count-slice-node)

(deftype PersistentSortedSet [_meta _cmp ^:unsynchronized-mutable _address ^:unsynchronized-mutable _storage
                              ^:unsynchronized-mutable _root ^:unsynchronized-mutable _count
                              ^:unsynchronized-mutable _settings ^:unsynchronized-mutable _version]
  IPersistentSortedSet
  (root [this]
    (when (and (nil? _root) (some? _address))
      (let [r0 (.restore ^IStorage _storage _address)
            r (stamp-proj-cmp r0 _cmp)
            ^Settings rs (node-settings r)]
        (when (and (<= (.-_diffBufSize ^Settings _settings) 0)
                   (pos? (.-_diffBufSize rs)))
          (set! _settings (Settings. (.-_branchingFactor ^Settings _settings)
                                     (.-_edit ^Settings _settings)
                                     (.-_diffBufSize rs)
                                     (.-_refType ^Settings _settings))))
        (set! _root r)))
    (when (and (branch? _root) (nil? (.-_projCmp ^Branch _root)))
      (set! _root (stamp-proj-cmp _root _cmp)))
    _root)
  (comparator [_] _cmp)
  (hasSubtreeCounts [this] (>= (subtree-count (.root this)) 0))
  (cons [this key cmp]
    (when (nil? key) (throw (IllegalArgumentException. "PersistentSortedSet cannot store nil")))
    (ensure-live-transient _settings)
    (let [nodes (node-add (.root this) _storage key cmp _settings)]
      (if (identical? nodes UNCHANGED)
        this
        (do
          (when (and _storage _address) (.markFreed ^IStorage _storage _address))
          (if (settings-editable? _settings)
            (do (set! _address nil)
                (cond (== 1 (alength nodes)) (set! _root (aget nodes 0))
                      (>= (alength nodes) 2) (set! _root (grow-root nodes _settings _cmp)))
                (when (>= _count 0) (set! _count (inc _count)))
                (set! _version (inc _version))
                this)
            (let [new-root (if (== 1 (alength nodes)) (aget nodes 0) (grow-root nodes _settings _cmp))
                  rc (subtree-count new-root)]
              (PersistentSortedSet. _meta _cmp nil _storage new-root (if (>= rc 0) rc -1) _settings (inc _version))))))))
  (disjoin [this key cmp]
    (ensure-live-transient _settings)
    (let [nodes (node-remove (.root this) _storage key nil nil cmp _settings)]
      (cond
        (identical? nodes UNCHANGED) this
        :else
        (do
          (when (and _storage _address) (.markFreed ^IStorage _storage _address))
          (if (identical? nodes EARLY_EXIT)
            (do (set! _address nil)
                (when (>= _count 0) (set! _count (dec _count)))
                (set! _version (inc _version))
                this)
            (let [nr (aget nodes 1)
                  nr (if (and (branch? nr) (== 1 (node-len nr))) (node-child nr _storage 0) nr)]
              (if (settings-editable? _settings)
                (do (set! _address nil) (set! _root nr)
                    (when (>= _count 0) (set! _count (dec _count)))
                    (set! _version (inc _version))
                    this)
                (let [rc (subtree-count nr)]
                  (PersistentSortedSet. _meta _cmp nil _storage nr (if (>= rc 0) rc -1) _settings (inc _version))))))))))
  (replace [this old new] (.replace this old new _cmp))
  (replace [this old new cmp]
    ;; replace was the other way nil got in (upstream 0.5.145): (replace s 1 nil) held [nil]
    (when (nil? new) (throw (IllegalArgumentException. "PersistentSortedSet cannot store nil")))
    (ensure-live-transient _settings)
    (let [nodes (node-replace (.root this) _storage old new cmp _settings)]
      (cond
        (identical? nodes UNCHANGED) this
        :else
        (do (when (and _storage _address) (.markFreed ^IStorage _storage _address))
            (cond
              (identical? nodes EARLY_EXIT)
              (do (set! _address nil) (set! _version (inc _version)) this)
              (settings-editable? _settings)
              (do (set! _address nil) (set! _root (aget nodes 0)) (set! _version (inc _version)) this)
              :else
              (PersistentSortedSet. _meta _cmp nil _storage (aget nodes 0) _count _settings (inc _version)))))))
  (lookup [this key] (.lookup this key _cmp))
  (lookup [this key cmp]
    (loop [node (.root this)]
      (let [len (node-len node)]
        (when (pos? len)
          (let [idx (search-first (node-keys node) len key cmp)]
            (when (< idx len)
              (if (branch? node)
                (recur (node-child node _storage idx))
                (when (zero? (long (cmp (aget (node-keys node) idx) key)))
                  (read-key _storage (node-keys node) idx)))))))))
  (lookupGE [this key] (.lookupGE this key _cmp))
  (lookupGE [this key cmp]
    (loop [node (.root this)]
      (let [len (node-len node)]
        (when (pos? len)
          (let [idx (search-first (node-keys node) len key cmp)]
            (when (< idx len)
              (if (branch? node)
                (recur (node-child node _storage idx))
                (read-key _storage (node-keys node) idx))))))))
  (slice [this from to] (.slice this from to _cmp))
  (slice [this from to cmp]
    (let [root (.root this)]
      (when (pos? (node-len root))
        (->seq-slice this nil root from to cmp _version))))
  (rslice [this from to] (.rslice this from to _cmp))
  (rslice [this from to cmp]
    (let [root (.root this)]
      (when (pos? (node-len root))
        (->seq-rslice this nil root from to cmp _version))))
  (countSlice [this from to] (.countSlice this from to _cmp))
  (countSlice [this from to cmp]
    (if (and from to (pos? (long (cmp from to))))
      0
      (let [root (.root this)]
        (if (zero? (node-len root)) 0 (count-slice-node root _storage from to cmp)))))
  (walkAddresses [this on-address]
    (when (or (nil? _address) (on-address _address))
      (.walkAddresses ^INode (.root this) _storage on-address)))
  (store [this]
    (when (nil? _address)
      (set! _address (.store ^INode _root _storage)))
    _address)
  (store [this storage] (set! _storage storage) (.store this))
  (forwardCursor [this] (.forwardCursor this _cmp))
  (forwardCursor [this cmp]
    ;; cmp may be a java.util.Comparator, as on the JVM (datahike.query.execute's fast-cmp-ea):
    ;; the cursor calls its comparator as a fn, so one is made from .compare
    (let [cmp (if (fn? cmp) cmp (fn [a b] (.compare ^java.util.Comparator cmp a b)))
          root (.root this)]
      (if (zero? (node-len root))
        (ForwardCursor. this cmp nil 0 nil nil 0)
        (let [height (loop [n root h 0] (if (branch? n) (recur (node-child n _storage 0) (inc h)) h))
              branches (object-array height)
              idxs (int-array height)
              leaf (loop [n root lvl 0]
                     (if (< lvl height)
                       (do (aset branches lvl n) (recur (node-child n _storage 0) (inc lvl)))
                       n))]
          (ForwardCursor. this cmp leaf 0 branches idxs height)))))

  clojure.lang.IPersistentSet
  (disjoin [this key] (.disjoin this key _cmp))
  (contains [this key] (node-contains? (.root this) _storage key _cmp))
  (get [this key] (when (node-contains? (.root this) _storage key _cmp) key))
  clojure.lang.IPersistentCollection
  (count [this]
    (when (neg? _count) (set! _count (node-count (.root this) _storage)))
    _count)
  (cons [this key] (.cons this key _cmp))
  (empty [this] (PersistentSortedSet. _meta _cmp nil _storage (Leaf. 0 (object-array 0) _settings) 0 _settings 0))
  (equiv [this o]
    (and (set? o) (== (count this) (count o))
         (every? #(contains? o %) (seq this))))
  clojure.lang.Counted
  clojure.lang.Seqable
  (seq [this] (.slice this nil nil _cmp))
  clojure.lang.Reversible
  (rseq [this] (.rslice this nil nil _cmp))
  clojure.lang.ILookup
  (valAt [this k] (.get this k))
  (valAt [this k nf] (if (.contains this k) k nf))
  clojure.lang.IFn
  (invoke [this k] (.get this k))
  (invoke [this k nf] (if (.contains this k) k nf))
  clojure.lang.IMeta
  (meta [_] _meta)
  clojure.lang.IObj
  (withMeta [this m]
    (if (identical? m _meta) this
        (PersistentSortedSet. m _cmp _address _storage _root _count _settings _version)))
  clojure.lang.IEditableCollection
  (asTransient [this]
    (when (settings-editable? _settings) (throw (ex-info "Expected persistent set" {})))
    (PersistentSortedSet. _meta _cmp _address _storage _root _count
                          (Settings. (.-_branchingFactor ^Settings _settings)
                                     (volatile! true)
                                     (.-_diffBufSize ^Settings _settings)
                                     (.-_refType ^Settings _settings))
                          _version))
  clojure.lang.ITransientSet
  (conj [this key] (.cons this key _cmp))
  (persistent [this]
    (when-not (settings-editable? _settings) (throw (ex-info "Expected transient set" {})))
    ;; a NEW set, as every Clojure transient's persistent! returns: this handle keeps the
    ;; sealed edit flag, so a later conj!/disj! on it throws (ensure-live-transient)
    (vreset! (.-_edit ^Settings _settings) false)
    (PersistentSortedSet. _meta _cmp _address _storage _root _count
                          (Settings. (.-_branchingFactor ^Settings _settings)
                                     nil
                                     (.-_diffBufSize ^Settings _settings)
                                     (.-_refType ^Settings _settings))
                          _version))
  clojure.lang.IReduceInit
  (reduce [this f init] (if-let [s (.slice this nil nil _cmp)] (seq-reduce s f init) init))
  clojure.lang.IHashEq
  (hasheq [this] (hash-unordered-coll (seq this)))
  Object
  (hashCode [this] (reduce (fn [h k] (+ h (hash k))) 0 this))
  (equals [this o] (.equiv this o))
  (toString [this] (str "#{" (clojure.string/join " " (map str this)) "}")))


(defn- set-storage
  "The storage of sorted set s: defined after its type, so the field read resolves (a Seq or cursor, defined before
  the set, reading it through a hint unresolved there, read it reflectively, ~90 B a seek)."
  [^PersistentSortedSet s] (.-_storage s))

(defn- grow-root [nodes settings proj-cmp]
  (let [n (alength nodes)
        keys (object-array n)
        children (object-array n)]
    (dotimes [i n]
      (aset keys i (node-max-key (aget nodes i)))
      (aset children i (aget nodes i)))
    (Branch. (inc (if (leaf? (aget nodes 0)) 0 (.-_level ^Branch (aget nodes 0))))
             n keys nil children (children-count children n) settings nil 0 proj-cmp)))

(defn- count-slice-node ^long [node storage from to cmp]
  (let [len (node-len node) keys (node-keys node)]
    (if (leaf? node)
      (let [fi (if from (search-first keys len from cmp) 0)
            ti (if to (search-last keys len to cmp) (dec len))]
        (if (or (>= fi len) (neg? ti)) 0 (max 0 (inc (- ti fi)))))
      (let [fi (if from (min (search-first keys len from cmp) (dec len)) 0)
            ti (if to (max 0 (min (inc (search-last keys len to cmp)) (dec len))) (dec len))]
        (if (== fi ti)
          (count-slice-node (node-child node storage fi) storage from to cmp)
          (+ (count-slice-node (node-child node storage fi) storage from nil cmp)
             (loop [i (inc fi) acc 0]
               (if (< i ti)
                 (let [^Slot sl (when (nil? (when-let [cs (.-_children ^Branch node)] (aget cs i)))
                                  (slot-at node i))]
                   (if sl
                     (recur (inc i) (+ acc (.-count sl)))
                     (let [c (node-child node storage i) k (subtree-count c)]
                       (recur (inc i) (+ acc (if (>= k 0) k (node-count c storage)))))))
                 acc))
             (count-slice-node (node-child node storage ti) storage nil to cmp)))))))

;; ---------------------------------------------------------------------------
;; Public API (the jar's org/replikativ/persistent_sorted_set.clj, same names and arities)

(defn conj [^PersistentSortedSet set key cmp] (.cons set key cmp))
(defn disj [^PersistentSortedSet set key cmp] (.disjoin set key cmp))

(defn slice
  ([^PersistentSortedSet set from to] (.slice set from to))
  ([^PersistentSortedSet set from to cmp] (.slice set from to cmp)))

(defn rslice
  ([^PersistentSortedSet set from to] (.rslice set from to))
  ([^PersistentSortedSet set from to cmp] (.rslice set from to cmp)))

(defn count-slice
  ([^PersistentSortedSet set from to] (.countSlice set from to))
  ([^PersistentSortedSet set from to cmp] (.countSlice set from to cmp)))

(defn has-subtree-counts? [^PersistentSortedSet set] (.hasSubtreeCounts set))

(defn seek
  ([seq to] (when seq (.seek ^Seq seq to)))
  ([seq to cmp] (when seq (.seek ^Seq seq to cmp))))

(defn lookup
  ([^PersistentSortedSet set key] (.lookup set key))
  ([^PersistentSortedSet set key cmp] (.lookup set key cmp)))

(defn replace
  ([^PersistentSortedSet set old-key new-key] (.replace set old-key new-key))
  ([^PersistentSortedSet set old-key new-key cmp] (.replace set old-key new-key cmp)))

(defn- map->settings ^Settings [m]
  (make-settings (or (:branching-factor m) 0)
                 (:ref-type m)
                 (or (:diff-buf-size m) 0)
                 (boolean (:edge-append? m))))

(defn- settings->map [^Settings s]
  {:branching-factor (.-_branchingFactor s)
   :ref-type (if (settings-weak? s) :weak :strong)
   :measure nil
   :leaf-processor nil
   :diff-buf-size (.-_diffBufSize s)
   :edge-append? (settings-edge-append? s)})

(defn- split-arrays
  "PSS's bulk split: chunks of avg length while at least 2*avg remain, then one or two."
  [arr ^long len ^long avg ^long mx]
  (loop [from 0 res (transient [])]
    (let [n (- len from)]
      (cond
        (== 0 n) (persistent! res)
        (>= n (* 2 avg)) (recur (+ from avg) (conj! res (java.util.Arrays/copyOfRange arr from (+ from avg))))
        (<= n mx) (persistent! (conj! res (java.util.Arrays/copyOfRange arr from len)))
        :else (let [h (quot n 2)]
                (persistent! (-> res
                                 (conj! (java.util.Arrays/copyOfRange arr from (+ from h)))
                                 (conj! (java.util.Arrays/copyOfRange arr (+ from h) len)))))))))

(defn from-sorted-array
  ([cmp keys] (from-sorted-array cmp keys (arrays/alength keys) {}))
  ([cmp keys len] (from-sorted-array cmp keys len {}))
  ([cmp keys len opts]
   (let [arr (if (arrays/array? keys) keys (to-array keys))
         ;; len names a real prefix of keys, and no key is nil (upstream 0.5.145): a len past
         ;; the array, or a nil key, made a set holding nil, durable once stored
         _ (when (or (neg? len) (> len (alength arr)))
             (throw (ex-info "from-sorted-array: len out of range" {:len len :array-length (alength arr)})))
         _ (dotimes [i len]
             (when (nil? (aget arr i))
               (throw (IllegalArgumentException. (str "PersistentSortedSet cannot store nil (index " i ")")))))
         settings (map->settings opts)
         mx (.-_branchingFactor settings)
         avg (quot (+ (unsigned-bit-shift-right mx 1) mx) 2)
         storage (:storage opts)]
     (loop [level 1
            nodes (mapv (fn [^objects ks] (Leaf. (alength ks) ks settings))
                        (split-arrays arr len avg mx))]
       (case (count nodes)
         ;; (:meta opts), as sorted-set* (upstream 0.5.145: the bulk builders dropped it)
         0 (PersistentSortedSet. (:meta opts) cmp nil storage (Leaf. 0 (object-array 0) settings) 0 settings 0)
         1 (PersistentSortedSet. (:meta opts) cmp nil storage (first nodes) len settings 0)
         (recur (inc level)
                (mapv (fn [^objects children]
                        (let [n (alength children)
                              ks (object-array n)]
                          (dotimes [i n] (aset ks i (node-max-key (aget children i))))
                          (Branch. level n ks nil children (children-count children n) settings nil 0 cmp)))
                      (split-arrays (to-array nodes) (count nodes) avg mx))))))))

(declare dedupe-by-cmp)
(defn from-sequential
  ([cmp keys] (from-sequential cmp keys {}))
  ([cmp keys opts]
   (when (some nil? keys) (throw (IllegalArgumentException. "PersistentSortedSet cannot store nil")))
   (let [sorted (vec (dedupe-by-cmp cmp (sort cmp keys)))]
     (from-sorted-array cmp (to-array sorted) (count sorted) opts))))

(defn- dedupe-by-cmp [cmp xs]
  (let [out (java.util.ArrayList.)]
    (doseq [x xs]
      (when (or (zero? (.size out)) (not (zero? (long (cmp (.get out (dec (.size out))) x)))))
        (.add out x)))
    out))

(defn sorted-set* [opts]
  (let [settings (map->settings opts)]
    (PersistentSortedSet. (:meta opts) (or (:comparator opts) (:cmp opts) compare) nil (:storage opts)
                          (Leaf. 0 (object-array 0) settings) 0 settings 0)))

(defn sorted-set-by
  ([cmp] (sorted-set* {:comparator cmp}))
  ([cmp & keys] (from-sequential cmp keys)))

(defn sorted-set
  ([] (sorted-set* {}))
  ([& keys] (from-sequential compare keys)))

(defn restore-by
  ([cmp address storage] (restore-by cmp address storage {}))
  ([cmp address storage opts]
   (PersistentSortedSet. nil cmp address storage nil -1 (map->settings opts) 0)))

(defn restore
  "A set read lazily from storage at address, under (:comparator opts) or (:cmp opts), else
  compare (upstream 0.5.145: restore ignored :comparator, so a set stored under another
  comparator came back navigated by compare)."
  ([address storage] (restore-by compare address storage {}))
  ([address storage opts] (restore-by (or (:comparator opts) (:cmp opts) compare) address storage opts)))

(defn walk-addresses [^PersistentSortedSet set consume-fn] (.walkAddresses set consume-fn))

(defn store
  ([^PersistentSortedSet set] (.store set))
  ([^PersistentSortedSet set storage] (.store set storage)))

(defn settings [^PersistentSortedSet set] (settings->map (.-_settings set)))

;; Node constructors for storage read handlers (ANode.restore in the Java)
(defn restore-node
  "A Leaf (level 0 or no addresses) or a Branch from stored keys/addresses (and optional diff-buf slots)."
  ([level keys addresses settings] (restore-node level keys addresses -1 settings nil))
  ([level keys addresses subtree-count settings] (restore-node level keys addresses subtree-count settings nil))
  ([level keys addresses subtree-count settings slots]
   (let [ks (to-array keys) n (alength ks)]
     (if (or (zero? level) (nil? addresses))
       (Leaf. n ks settings)
       (let [as (to-array addresses)
             b (Branch. level n ks as nil (long (or subtree-count -1)) settings nil BUF_LAZY nil)]
         (when (seq slots)
           (let [sarr (object-array n)]
             (reduce-kv (fn [_ k entry]
                          (let [i (int k)]
                            (aset sarr i (Slot. (:diff entry) (long (:count entry)) (:measure entry)
                                                (aget as i) BUF_LAZY)))
                          nil)
                        nil slots)
             (install-slots! b sarr BUF_LAZY)))
         b)))))

(defn default-settings
  ([bf] (make-settings bf))
  ([bf ref-type] (make-settings bf ref-type))
  ([bf ref-type diff-buf-size] (make-settings bf ref-type diff-buf-size))
  ([bf ref-type diff-buf-size edge-append?] (make-settings bf ref-type diff-buf-size edge-append?)))

;; ---------------------------------------------------------------------------
;; EDN form of stored nodes (konserve StringSerializer on Jolt; the JVM uses Fressian).
;; Tags have no dot in their namespace: Jolt's clojure.edn ignores :readers for #a.b/T.

;; Nodes are written by a direct emitter rather than the generic printer: Jolt's
;; print-method path costs ~0.19 us per output byte (konserve-on-jolt.md), the emitter
;; ~0.01 (proto/core dev/pb.clj: 64 datoms, 748 -> 35 us), and a commit writes every
;; node it touched. A datahike.datom.Datom key is written as #datahike/Datom [e a v tx
;; added], byte for byte what its print-method writes; any other key goes through pr-str.

(defn- emit-value [^StringBuilder sb v]
  (cond (string? v) (.append sb (pr-str v))
        (or (keyword? v) (symbol? v) (int? v) (boolean? v)) (.append sb (str v))
        :else (.append sb (pr-str v))))

(defn- emit-key [^StringBuilder sb k]
  (if (= "datahike.datom.Datom" (.getName (class k)))
    (let [tx (.-tx k)]
      (.append sb "#datahike/Datom [") (.append sb (str (.-e k))) (.append sb " ")
      (emit-value sb (.-a k)) (.append sb " ") (emit-value sb (.-v k)) (.append sb " ")
      (.append sb (str (if (pos? tx) tx (- tx)))) (.append sb (if (pos? tx) " true]" " false]")))
    (.append sb (pr-str k))))

(defn- emit-keys [^StringBuilder sb ^objects ks n]
  (.append sb "[")
  (dotimes [i n] (when (pos? i) (.append sb " ")) (emit-key sb (aget ks i)))
  (.append sb "]"))

(defmethod print-method Leaf [^Leaf n ^java.io.Writer w]
  (let [sb (StringBuilder.)]
    (.append sb "#pss/leaf ")
    (emit-keys sb (.-_keys n) (.-_len n))
    (.write w (.toString sb))))

(defmethod print-method Branch [^Branch n ^java.io.Writer w]
  (let [sb (StringBuilder.)]
    (.append sb "#pss/branch {:level ") (.append sb (str (.-_level n)))
    (.append sb ", :keys ") (emit-keys sb (.-_keys n) (.-_len n))
    (.append sb ", :addresses ") (.append sb (pr-str (.addresses n)))
    (.append sb ", :subtree-count ") (.append sb (str (.-_subtreeCount n)))
    (when-let [sl (.slotsForStorage n)]
      (.append sb ", :slots ") (.append sb (pr-str sl)))
    (.append sb "}")
    (.write w (.toString sb))))

(defn edn-read-handlers
  "EDN tag readers for stored nodes; settings is the store's (branching factor)."
  [settings]
  {'pss/leaf (fn [ks] (restore-node 0 ks nil settings))
   'pss/branch (fn [{:keys [level keys addresses subtree-count slots]}]
                 (restore-node level keys addresses subtree-count settings slots))})
